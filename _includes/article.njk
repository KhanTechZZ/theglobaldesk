<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} | The Global Desk</title>
  <meta name="description" content="{{ description or title }}">
  <meta name="theme-color" content="#08295f">
  <meta property="og:site_name" content="The Global Desk">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="canonical" href="https://thegdesk.com{{ page.url }}">
  {% if image %}
  <meta property="og:image" content="https://thegdesk.com{{ image }}">
  {% endif %}
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description or title }}">
  <meta property="og:type" content="article">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Libre+Franklin:wght@500;600;700;800;900&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700;8..60,800;8..60,900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/homepage.css?v=20261126-category-grid-consistency">
  <style>
    .gd-article-page{padding-top:2rem;padding-bottom:4rem;max-width:900px}
    .gd-article-category{display:inline-block;color:#B8871A;font-size:.75rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase;margin-bottom:.7rem}
    .gd-article-title{font-family:var(--gd-font-serif);font-size:clamp(2rem,5vw,3.6rem);line-height:1.13;letter-spacing:-.035em;color:#141414;margin:0 0 1rem}
    .gd-article-description{font-size:1.12rem;line-height:1.65;color:#555;margin:0 0 1.3rem;max-width:780px}
    .gd-article-meta{display:flex;flex-wrap:wrap;gap:.5rem 1rem;align-items:center;border-top:1px solid #e5e5e5;border-bottom:1px solid #e5e5e5;padding:.9rem 0;margin:1.3rem 0 1.6rem;font-size:.78rem;color:#767676}
    .gd-article-meta strong{color:#222}
    .gd-article-image{width:100%;max-height:560px;object-fit:cover;margin:0 0 2rem;background:#f4f4f4}
    .gd-article-body{font-family:var(--gd-font-serif);font-size:1.16rem;line-height:1.85;color:#252525;max-width:760px;margin:0 auto}
    .gd-article-body p{margin:0 0 1.35em}
    .gd-article-body h2,.gd-article-body h3{font-family:var(--gd-font);line-height:1.3;margin:1.8em 0 .7em;color:#141414}
    .gd-article-body h2{font-size:1.55rem}.gd-article-body h3{font-size:1.25rem}
    .gd-article-body a{color:#00205F;text-decoration:underline}
    .gd-article-body blockquote{border-left:4px solid #DFA321;padding:.5rem 1.2rem;margin:1.5rem 0;color:#555}
    .gd-article-body img{height:auto;margin:1.5rem auto}
    .gd-article-body ul,.gd-article-body ol{padding-left:1.5rem;list-style:revert;margin:0 0 1.3em}
    .gd-article-body li{margin:.4em 0}
    .gd-article-back{display:inline-block;margin-top:2.5rem;color:#00205F;font-size:.85rem;font-weight:800}
    @media(max-width:700px){.gd-article-page{padding-top:1.4rem}.gd-article-title{font-size:2.15rem}.gd-article-description{font-size:1rem}.gd-article-body{font-size:1.08rem}}

  /* ==========================================
     THE GLOBAL DESK — PREMIUM ARTICLE DESIGN
  ========================================== */

  .gd-article-page {
    max-width: 1100px;
    padding: 38px 28px 90px;
  }

  .gd-article-page > article > header {
    max-width: 920px;
    margin: 0 auto;
  }

  .gd-article-category {
    display: inline-block;
    color: #a77b20;
    font-family: var(--gd-font);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .13em;
    text-transform: uppercase;
    margin-bottom: 17px;
  }

  .gd-article-title {
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: clamp(38px, 5.2vw, 64px);
    font-weight: 800;
    line-height: 1.09;
    letter-spacing: -.045em;
    color: #101820;
    margin: 0 0 22px;
    max-width: 900px;
  }

  .gd-article-description {
    max-width: 820px;
    font-family: 'Inter', sans-serif;
    font-size: clamp(17px, 2vw, 21px);
    line-height: 1.65;
    color: #555e68;
    margin: 0 0 27px;
  }

  .gd-article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 22px;
    border-top: 1px solid #e5e7eb;
    border-bottom: 1px solid #e5e7eb;
    padding: 17px 0;
    margin: 0 0 30px;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    color: #747b84;
  }

  .gd-article-meta strong {
    color: #172333;
    font-weight: 700;
  }

  .gd-article-image {
    display: block;
    width: 100%;
    max-height: 620px;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin: 0 auto 44px;
    background: #f0f1f2;
  }

  .gd-article-body {
    max-width: 740px;
    margin: 0 auto;
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: 19px;
    line-height: 1.9;
    color: #292e35;
  }

  .gd-article-body p {
    margin: 0 0 1.55em;
  }

  .gd-article-body h2 {
    font-family: 'Inter', sans-serif;
    font-size: 29px;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -.025em;
    color: #101820;
    margin: 2em 0 .75em;
  }

  .gd-article-body h3 {
    font-family: 'Inter', sans-serif;
    font-size: 22px;
    font-weight: 700;
    line-height: 1.35;
    color: #172333;
    margin: 1.8em 0 .7em;
  }

  .gd-article-body a {
    color: #123e70;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .gd-article-body blockquote {
    border-left: 4px solid #c5a447;
    padding: 8px 0 8px 24px;
    margin: 2em 0;
    color: #555e68;
    font-size: 21px;
    line-height: 1.65;
  }

  .gd-article-body img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 2em auto;
  }

  .gd-article-body ul,
  .gd-article-body ol {
    padding-left: 1.5rem;
    margin: 0 0 1.5em;
  }

  .gd-article-body li {
    margin: .55em 0;
  }

  .gd-article-back {
    display: inline-block;
    margin-top: 55px;
    padding-top: 18px;
    border-top: 1px solid #e5e7eb;
    color: #123e70;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
  }

  @media (max-width: 700px) {
    .gd-article-page {
      padding: 24px 18px 60px;
    }

    .gd-article-title {
      font-size: clamp(34px, 9vw, 44px);
      line-height: 1.12;
      letter-spacing: -.035em;
    }

    .gd-article-description {
      font-size: 16px;
      line-height: 1.65;
    }

    .gd-article-meta {
      padding: 14px 0;
      margin-bottom: 22px;
    }

    .gd-article-image {
      aspect-ratio: 4 / 3;
      margin-bottom: 30px;
    }

    .gd-article-body {
      font-size: 17px;
      line-height: 1.85;
    }

    .gd-article-body h2 {
      font-size: 25px;
    }

    .gd-article-body h3 {
      font-size: 20px;
    }
  }


  /* ARTICLE HEADLINE REFINEMENT */
  .gd-article-title {
    font-size: clamp(34px, 4.6vw, 56px);
  }

  .gd-article-image {
    margin-bottom: 0;
  }

  .gd-article-image-caption {
    max-width: 1100px;
    margin: 10px 0 40px;
    color: #858585;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    line-height: 1.5;
  }

  @media (max-width: 700px) {
    .gd-article-title {
      font-size: clamp(30px, 8vw, 38px);
    }

    .gd-article-image-caption {
      margin: 8px 0 28px;
      font-size: 10px;
    }
  }


  /* BBC STYLE TYPOGRAPHY REFINEMENT */

  .gd-article-page {
    max-width: 1000px;
    padding: 32px 24px 76px;
  }

  .gd-article-page > article > header {
    max-width: 820px;
    margin: 0 auto 26px;
  }

  .gd-article-title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(30px, 3.2vw, 42px);
    line-height: 1.16;
    letter-spacing: -0.025em;
    font-weight: 700;
    color: #111;
    margin: 14px 0 18px;
  }

  .gd-article-description {
    font-size: 18px;
    line-height: 1.55;
    font-weight: 400;
    color: #444;
    max-width: 760px;
  }

  .gd-article-image {
    display: block;
    width: 100%;
    max-height: 540px;
    object-fit: cover;
    margin-bottom: 0;
  }

  .gd-article-image-caption {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 9px 0 34px;
    font-family: Arial, sans-serif;
    font-size: 12px;
    line-height: 1.45;
    color: #555;
  }

  .gd-image-caption-text {
    color: #555;
    font-size: 12px;
  }

  .gd-image-credit {
    color: #777;
    font-size: 11px;
  }

  .gd-article-body {
    max-width: 680px;
    margin: 0 auto;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.65;
    letter-spacing: 0;
    color: #222;
  }

  .gd-article-body p {
    margin: 0 0 1.25em;
    font-weight: 400;
  }

  .gd-article-body h2 {
    font-size: 27px;
    line-height: 1.3;
    margin: 1.7em 0 .65em;
  }

  .gd-article-body h3 {
    font-size: 22px;
    line-height: 1.35;
  }

  @media (max-width: 700px) {
    .gd-article-page {
      padding: 24px 18px 54px;
    }

    .gd-article-title {
      font-size: 31px;
      line-height: 1.17;
    }

    .gd-article-description {
      font-size: 16px;
      line-height: 1.55;
    }

    .gd-article-body {
      font-size: 17px;
      line-height: 1.7;
    }

    .gd-article-body h2 {
      font-size: 24px;
    }

    .gd-article-image-caption {
      margin-bottom: 26px;
    }
  }

  .gd-article-body { font-size: var(--gd-reader-font-size, 18px) !important; }
  .gd-reader-tools {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: .65rem;
    max-width: 820px;
    margin: 1.4rem auto 1.7rem;
    padding: .55rem 0;
    border-top: 1px solid #dce2e8;
    border-bottom: 1px solid #dce2e8;
    font-family: 'Inter', sans-serif;
    overflow-x: auto;
    scrollbar-width: thin;
  }
  .gd-reader-tools button,
  .gd-reader-tools select,
  .gd-reader-tools__saved-link {
    display: inline-flex;
    flex: 0 0 auto;
    min-width: 36px;
    min-height: 36px;
    align-items: center;
    justify-content: center;
    gap: .35rem;
    padding: .35rem .48rem;
    border: 1px solid #c7d0d9;
    border-radius: 3px;
    background: #fff;
    color: #17304b;
    font: inherit;
    font-size: .72rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
  }
  .gd-reader-tools svg { width: 17px; height: 17px; flex: 0 0 17px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .gd-reader-tools__status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; }
  .gd-reader-tools button:hover,
  .gd-reader-tools a:hover { border-color: #12375f; background: #f2f6f9; }
  .gd-reader-tools button[aria-pressed="true"] { border-color: #12375f; background: #12375f; color: #fff; }
  .gd-reader-tools :focus-visible,
  .gd-related-stories a:focus-visible { outline: 3px solid #c49632; outline-offset: 3px; }
  body[data-article-slug] .gd-article-page { width: 100%; max-width: 840px; }
  body[data-article-slug] .gd-article-body { max-width: 660px; }
  .gd-related-stories { margin: 3.25rem auto 0; padding-top: 1.5rem; border-top: 1px solid #dce2e8; }
  .gd-related-stories__heading > span { color: #8c6617; font: 800 .72rem/1.3 'Inter',sans-serif; letter-spacing: .1em; text-transform: uppercase; }
  .gd-related-stories__heading h2 { margin: .35rem 0 1.2rem; color: #17304b; font: 750 clamp(1.5rem,3vw,2rem)/1.2 Georgia,serif; }
  .gd-related-stories__grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1.5rem; }
  .gd-related-story { min-width: 0; border: 0; background: transparent; }
  .gd-related-story > a { display: flex; height: 100%; flex-direction: column; color: inherit; text-decoration: none; }
  .gd-related-story__media { width: 100%; aspect-ratio: 16 / 10; overflow: hidden; background: #e8edf1; }
  .gd-related-story__media img, .gd-related-story__media .gd-image-placeholder { display: block; width: 100%; height: 100%; aspect-ratio: 16 / 10; object-fit: cover; transition: transform .25s ease; }
  .gd-related-story > a:hover .gd-related-story__media img { transform: scale(1.035); }
  .gd-related-story__body { display: flex; min-height: 150px; flex: 1; flex-direction: column; align-items: flex-start; padding: .75rem 0 0; }
  .gd-related-story > a:hover h3 { color: #8c6617; }
  .gd-related-story__category { color: #8c6617; font: 800 .7rem/1.3 'Inter',sans-serif; letter-spacing: .07em; text-transform: uppercase; }
  .gd-related-story h3 { margin: .45rem 0; color: #17304b; font: 700 1.15rem/1.27 Georgia,serif; }
  .gd-related-story p { display: -webkit-box; overflow: hidden; margin: 0 0 .65rem; color: #526273; font: .875rem/1.5 'Inter',sans-serif; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
  .gd-related-story__date { margin-top: auto; color: #758292; font: 650 .72rem/1.4 'Inter',sans-serif; }
  .gd-related-stories__empty { color: #526273; line-height: 1.6; }
  .gd-related-stories__empty a { color: #12375f; font-weight: 750; }
  .gd-more-desk { margin:3rem auto 0; padding:1.35rem 0 0; border-top:1px solid #dce2e8; background:#fff; }
  .gd-more-desk__heading { margin:0 0 .55rem; }
  .gd-more-desk__heading > div { display:flex; flex-direction:column; gap:.2rem; }
  .gd-more-desk__heading > div > span { color:#8c6617; font:800 .68rem/1.3 'Inter',sans-serif; letter-spacing:.11em; text-transform:uppercase; }
  .gd-more-desk__heading h2 { margin:0; color:#17304b; font:750 clamp(1.55rem,3vw,2.05rem)/1.16 Georgia,serif; }
  .gd-more-desk__list { display:flex; flex-direction:column; }
  .gd-more-desk__item { min-width:0; border:0; border-bottom:1px solid #e2e6e8; background:transparent; }
  .gd-more-desk__item:last-child { border-bottom:0; }
  .gd-more-desk__link { display:grid; grid-template-columns:minmax(180px,32%) minmax(0,1fr); gap:1.2rem; align-items:center; padding:1rem 0; color:inherit; text-decoration:none; }
  .gd-more-desk__media { position:relative; width:100%; aspect-ratio:16 / 10; overflow:hidden; background:#dce4e5; }
  .gd-more-desk__media img { display:block; width:100%; height:100%; object-fit:cover; transition:transform .35s ease; }
  .gd-more-desk__link:hover .gd-more-desk__media img { transform:scale(1.035); }
  .gd-more-desk__image-note { position:absolute; right:.55rem; bottom:.55rem; padding:.25rem .42rem; background:rgba(13,35,53,.78); color:#fff; font:650 .58rem/1.2 'Inter',sans-serif; }
  .gd-more-desk__body { display:flex; min-width:0; flex-direction:column; align-items:flex-start; padding:.25rem 0; }
  .gd-more-desk__meta { color:#866b35; font:800 .64rem/1.35 'Inter',sans-serif; letter-spacing:.07em; text-transform:uppercase; }
  .gd-more-desk__item h3 { margin:.4rem 0 .4rem; color:#20394e; font:750 clamp(1.05rem,1.7vw,1.25rem)/1.3 Georgia,serif; }
  .gd-more-desk__item p { display:-webkit-box; overflow:hidden; margin:0; color:#5b6871; font:400 .82rem/1.5 'Inter',sans-serif; -webkit-box-orient:vertical; -webkit-line-clamp:3; }
  .gd-more-desk__link:hover h3 { color:#8c6617; }
  .gd-more-desk__link:focus-visible { outline:3px solid #c49632; outline-offset:3px; }
  @media (max-width: 1000px) { .gd-related-stories__grid { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1.25rem; } }
  @media (max-width: 760px) {
    .gd-reader-tools { gap: .55rem; }
    .gd-more-desk { margin-top:2.25rem; padding-top:1rem; }
    .gd-more-desk__link { grid-template-columns:minmax(105px,34%) minmax(0,1fr); gap:.8rem; padding:.8rem 0; }
    .gd-more-desk__media { aspect-ratio:4 / 3; }
    .gd-more-desk__image-note { right:.3rem; bottom:.3rem; padding:.2rem .3rem; font-size:.5rem; }
    .gd-more-desk__meta { font-size:.56rem; }
    .gd-more-desk__item h3 { margin:.28rem 0; font-size:.96rem; line-height:1.27; }
    .gd-more-desk__item p { font-size:.72rem; line-height:1.38; -webkit-line-clamp:2; }
    .gd-related-stories__grid { grid-template-columns: minmax(0,1fr); gap: 1.25rem; }
    .gd-related-story { padding-bottom: 1rem; border-bottom: 1px solid #e2e7ec; }
    .gd-related-story:last-child { padding-bottom: 0; border-bottom: 0; }
    .gd-related-story > a { display: grid; grid-template-columns: minmax(105px,.85fr) minmax(0,1fr); gap: .85rem; align-items: start; }
    .gd-related-story__media { grid-column: 1; grid-row: 1; aspect-ratio: 4 / 3; }
    .gd-related-story__media img, .gd-related-story__media .gd-image-placeholder { aspect-ratio: 4 / 3; }
    .gd-related-story__body { grid-column: 2; grid-row: 1; min-height: 0; padding: 0; }
  }

  .gd-article-category { display: inline-block; margin: 0 0 .65rem; color: #b8871a; font: 800 1rem/1.3 'Inter',sans-serif; letter-spacing: .08em; text-transform: uppercase; }
  .gd-article-title { max-width: 780px; margin-bottom: .75rem; font-size: clamp(1.9rem,4.2vw,2.7rem) !important; line-height: 1.1 !important; letter-spacing: -.02em !important; text-align:left !important; text-justify:none; word-spacing:normal !important; white-space:normal; overflow-wrap:normal; word-break:normal; hyphens:none; text-wrap:balance; }
  .gd-article-description { max-width: 720px; margin-bottom: 1.15rem; color: #5b6269; font-size: clamp(1.08rem,2vw,1.4rem); font-style: italic; line-height: 1.55; }
  .gd-reader-tools { max-width: 660px; margin: .8rem auto 1.5rem; padding: .65rem 0; border-bottom: 0; }
  .gd-reader-tools button { min-height: 40px; padding: .4rem .65rem; }
  .gd-article-image { margin-bottom: 0; }
  .gd-article-image-caption { max-width: 760px; margin: .65rem auto 1.35rem; padding-left: .75rem; border-left: 2px solid #c49632; color: #647181; font: 500 .76rem/1.5 'Inter',sans-serif; }
  .gd-image-caption-text { color: #4d5b69; }
  .gd-image-credit { color: #768291; }
  .gd-article-meta { display: flex; justify-content: space-between; max-width: 660px; margin: 0 auto 1.5rem; padding: .8rem 0; border-top: 1px solid #e1e5e9; border-bottom: 1px solid #e1e5e9; color: #5f6d7b; font: 600 .78rem/1.5 'Inter',sans-serif; }
  .gd-article-meta time { color: #697787; }
  .gd-article-meta strong { color: #17304b; }

</style>
</head>
<body data-local-menu-init="true" data-article-slug="{{ page.fileSlug }}" data-article-title="{{ title | escape }}" data-article-category="{{ category | escape }}" data-article-url="{{ page.url }}">

{% include 'global-header.njk' %}


  <main class="gd-container gd-article-page">
    <article>
      <header>
        <span class="gd-article-category">{{ (category or "News") | upper }}</span>
        <h1 class="gd-article-title">{{ title }}</h1>
        {% if description %}
        <p class="gd-article-description">{{ description }}</p>
        {% endif %}
      </header>

      <div class="gd-reader-tools" role="toolbar" aria-label="Article actions">
        <button type="button" data-reader-listen aria-label="Listen to article" title="Listen to article">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10v4h4l5 4V6l-5 4z"/><path d="M17 9a5 5 0 0 1 0 6M19.5 6.5a9 9 0 0 1 0 11"/></svg>
          <span data-listen-label>Listen</span><span class="gd-read-time" data-reading-time>(… mins)</span>
        </button>
        <button type="button" data-reader-save aria-label="Save to reading list" title="Save to reading list" aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4.5h12v16l-6-4-6 4z"/></svg>
          <span data-reader-save-label>Save</span>
        </button>
        <button type="button" data-reader-share aria-label="Share article" title="Share article">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.7 10.6 6.6-4.2M8.7 13.4l6.6 4.2"/></svg>
          <span>Share</span>
        </button>
        <span class="gd-reader-tools__status" data-reader-status role="status" aria-live="polite"></span>
      </div>

      {% if image %}
      <img class="gd-article-image" src="{{ image }}" alt="{{ imageAlt or title }}" loading="eager" fetchpriority="high" decoding="async">
      {% if imageCaption or imageCredit %}
      <div class="gd-article-image-caption">
        {% if imageCaption %}
        <span class="gd-image-caption-text">{{ imageCaption }}</span>
        {% endif %}
        {% if imageCredit %}
        <span class="gd-image-credit">{{ imageCredit }}</span>
        {% endif %}
      </div>
      {% endif %}
      {% endif %}

      <div class="gd-article-meta">
        <span>By <strong>{{ author or "The Global Desk" }}</strong></span>
        {% if date %}<time datetime="{{ date | isoDate }}">Published {{ date | readableDate }}</time>{% endif %}
      </div>

      <div class="gd-article-body">
        {{ content | safe }}
      </div>
    </article>

    {% set relatedItems = collections.publishedNews | relatedNews(page.url, category, 3) %}
    <section class="gd-related-stories" aria-labelledby="gd-related-title">
      <div class="gd-related-stories__heading">
        <span>Keep reading</span>
        <h2 id="gd-related-title">Related stories</h2>
      </div>
      {% if relatedItems.length %}
      <div class="gd-related-stories__grid">
        {% for item in relatedItems %}
        <article class="gd-related-story">
          <a href="{{ item.url }}">
            <div class="gd-related-story__media">{% if item.data.image %}<img src="{{ item.data.image }}" alt="{{ item.data.title }}" loading="lazy" decoding="async">{% else %}<span class="gd-image-placeholder" aria-hidden="true"></span>{% endif %}</div>
            <div class="gd-related-story__body">
              <span class="gd-related-story__category">{{ item.data.category or "News" }}</span>
              <h3>{{ item.data.title }}</h3>
              {% if item.data.description %}<p>{{ item.data.description }}</p>{% endif %}
              <span class="gd-related-story__date">{{ item.date | readableDate }}</span>
            </div>
          </a>
        </article>
        {% endfor %}
      </div>
      {% else %}
      <p class="gd-related-stories__empty">More coverage is coming soon. <a href="/search/">Browse all stories</a>.</p>
      {% endif %}
    </section>

    {% set moreDeskItems = collections.publishedNews | moreFromDesk(page.url, relatedItems, 5) %}
    {% if moreDeskItems.length %}
    <section class="gd-more-desk" aria-labelledby="gd-more-desk-title">
      <div class="gd-more-desk__heading"><div><span>More to explore</span><h2 id="gd-more-desk-title">More from The Global Desk</h2></div></div>
      <div class="gd-more-desk__list">
        {% for item in moreDeskItems %}
        <article class="gd-more-desk__item">
          <a class="gd-more-desk__link" href="{{ item.url }}">
            <div class="gd-more-desk__media">
              <img src="{{ item.moreFromDeskImage }}" alt="{% if item.moreFromDeskIllustrative %}Illustrative image for {% else %}Photo for {% endif %}{{ item.data.title | escape }}" loading="lazy" decoding="async">
              {% if item.moreFromDeskIllustrative %}<span class="gd-more-desk__image-note">Illustrative image</span>{% endif %}
            </div>
            <div class="gd-more-desk__body">
              <span class="gd-more-desk__meta">{{ item.data.category or "News" }} · {{ item.date | readableDate }}</span>
              <h3>{{ item.data.title }}</h3>
              {% if item.data.description %}<p>{{ item.data.description }}</p>{% endif %}
            </div>
          </a>
        </article>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    <a class="gd-article-back" href="/">← More news</a>
  </main>

  {% include 'global-footer.njk' %}

  <script>
    // Homepage mobile navigation
    const menuBtn = document.getElementById('gd-menu-btn');
    const nav = document.getElementById('gd-nav');

    function setMenu(open) {
      if (!menuBtn || !nav) return;
      nav.classList.toggle('is-open', open);
      menuBtn.classList.toggle('is-open', open);
      menuBtn.setAttribute('aria-expanded', String(open));
      menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      document.body.classList.toggle('gd-menu-active', open);
      document.body.style.overflow = open ? 'hidden' : '';
    }

    if (menuBtn && nav) {
      menuBtn.setAttribute('aria-expanded', 'false');

      menuBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        setMenu(!nav.classList.contains('is-open'));
      });

      document.addEventListener('click', function (e) {
        if (window.innerWidth <= 768 &&
            nav.classList.contains('is-open') &&
            !nav.contains(e.target) &&
            !menuBtn.contains(e.target)) {
          setMenu(false);
        }
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && nav.classList.contains('is-open')) {
          setMenu(false);
          menuBtn.focus();
        }
      });

      window.addEventListener('resize', function () {
        if (window.innerWidth > 768) setMenu(false);
      });

      nav.addEventListener('click', function (e) {
        const toggle = e.target.closest('.gd-nav__dropdown-toggle');
        if (!toggle || window.innerWidth > 768) return;

        e.preventDefault();
        e.stopPropagation();

        const parent = toggle.closest('.gd-nav__dropdown');
        if (!parent) return;

        const willOpen = !parent.classList.contains('is-open');

        nav.querySelectorAll('.gd-nav__dropdown.is-open').forEach(function (item) {
          item.classList.remove('is-open');
          const itemToggle = item.querySelector('.gd-nav__dropdown-toggle');
          if (itemToggle) itemToggle.setAttribute('aria-expanded', 'false');
        });

        if (willOpen) {
          parent.classList.add('is-open');
          toggle.setAttribute('aria-expanded', 'true');
        }
      });

      nav.querySelectorAll('.gd-nav__dropdown-toggle').forEach(function (toggle) {
        toggle.setAttribute('role', 'button');
        toggle.setAttribute('tabindex', '0');
        toggle.setAttribute('aria-expanded', 'false');

        toggle.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            toggle.click();
          }
        });
      });
    }

    // Preserve article view counter
    (function () {
      const slug = document.body.dataset.articleSlug;
      if (slug) {
        fetch('/api/views', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug: slug }),
          keepalive: true
        }).catch(function () {});
      }
    })();

    // Article actions: read time, audio, saved stories and sharing.
    (function () {
      const articleBody = document.querySelector('.gd-article-body');
      const status = document.querySelector('[data-reader-status]');
      const savedKey = 'tgd-saved-stories-v1';
      const showStatus = function (message) {
        if (status) status.textContent = message;
      };
      const readSaved = function () {
        try {
          const items = JSON.parse(localStorage.getItem(savedKey) || '[]');
          return Array.isArray(items) ? items.filter(function (item) {
            return item && typeof item.url === 'string' && typeof item.title === 'string';
          }) : [];
        } catch (error) { return []; }
      };
      const store = function (key, value) {
        try { localStorage.setItem(key, value); return true; } catch (error) { return false; }
      };

      if (!articleBody) return;

      const readingTime = document.querySelector('[data-reading-time]');
      const wordCount = (articleBody.innerText || articleBody.textContent || '').trim().split(/\s+/).filter(Boolean).length;
      const minutes = Math.max(1, Math.ceil(wordCount / 200));
      if (readingTime) readingTime.textContent = '(' + minutes + (minutes === 1 ? ' min' : ' mins') + ')';

      const saveButton = document.querySelector('[data-reader-save]');
      const articleUrl = new URL(document.body.dataset.articleUrl || window.location.pathname, window.location.origin).pathname;
      const articleItem = {
        url: articleUrl,
        title: document.body.dataset.articleTitle || document.querySelector('.gd-article-title')?.textContent.trim() || 'The Global Desk story',
        category: document.body.dataset.articleCategory || 'News'
      };
      const updateSaveButton = function () {
        const isSaved = readSaved().some(function (item) { return item.url === articleItem.url; });
        if (saveButton) {
          saveButton.setAttribute('aria-pressed', String(isSaved));
          saveButton.setAttribute('aria-label', isSaved ? 'Remove from reading list' : 'Save to reading list');
          saveButton.title = isSaved ? 'Remove from reading list' : 'Save to reading list';
          const label = saveButton.querySelector('[data-reader-save-label]');
          if (label) label.textContent = isSaved ? 'Saved' : 'Save';
        }
      };
      updateSaveButton();
      if (saveButton) saveButton.addEventListener('click', function () {
        const items = readSaved();
        const index = items.findIndex(function (item) { return item.url === articleItem.url; });
        if (index >= 0) {
          items.splice(index, 1);
          if (store(savedKey, JSON.stringify(items))) showStatus('Removed from your reading list.');
          else showStatus('This browser could not update your saved stories.');
        } else {
          items.unshift(Object.assign({ savedAt: new Date().toISOString() }, articleItem));
          if (store(savedKey, JSON.stringify(items.slice(0, 100)))) showStatus('Saved to your reading list on this device.');
          else showStatus('This browser could not save the story.');
        }
        updateSaveButton();
      });

      const listenButton = document.querySelector('[data-reader-listen]');
      const listenLabel = listenButton && listenButton.querySelector('[data-listen-label]');
      const setListenLabel = function (label) {
        if (!listenButton) return;
        if (listenLabel) listenLabel.textContent = label;
        const action = label === 'Listen' ? 'Listen to article' : label + ' audio';
        listenButton.setAttribute('aria-label', action);
        listenButton.title = action;
      };
      const synth = window.speechSynthesis;
      if (!synth || !window.SpeechSynthesisUtterance) {
        if (listenButton) listenButton.hidden = true;
      } else {
        const chooseEnglishVoice = function () {
          const voices = synth.getVoices().filter(function (voice) { return /^en(?:-|$)/i.test(voice.lang || ''); });
          const score = function (voice) {
            const lang = (voice.lang || '').toLowerCase();
            const name = (voice.name || '').toLowerCase();
            let value = lang.startsWith('en-in') ? 35 : lang.startsWith('en-gb') ? 30 : lang.startsWith('en-us') ? 25 : 20;
            if (/natural|neural|online/.test(name)) value += 100;
            if (/google/.test(name)) value += 55;
            if (/microsoft/.test(name)) value += 45;
            if (/jenny|aria|sonia|ava|guy|samantha/.test(name)) value += 25;
            if (voice.default) value += 5;
            return value;
          };
          return voices.sort(function (a, b) { return score(b) - score(a); })[0] || null;
        };
        const resetAudioControls = function () {
          setListenLabel('Listen');
        };
        if (listenButton) listenButton.addEventListener('click', function () {
          if (synth.speaking && synth.paused) {
            synth.resume();
            setListenLabel('Pause');
            showStatus('Audio resumed.');
            return;
          }
          if (synth.speaking) {
            synth.pause();
            setListenLabel('Resume');
            showStatus('Audio paused.');
            return;
          }
          const utterance = new SpeechSynthesisUtterance(articleBody.innerText || articleBody.textContent || '');
          const englishVoice = chooseEnglishVoice();
          if (englishVoice) {
            utterance.voice = englishVoice;
            utterance.lang = englishVoice.lang;
          } else {
            utterance.lang = 'en-IN';
          }
          utterance.rate = 0.94;
          utterance.pitch = 1;
          utterance.onstart = function () {
            setListenLabel('Pause');
            showStatus('Reading the article aloud.');
          };
          utterance.onend = function () { resetAudioControls(); showStatus('Audio finished.'); };
          utterance.onerror = function () { resetAudioControls(); showStatus('Audio could not play in this browser.'); };
          synth.cancel();
          synth.speak(utterance);
        });
        window.addEventListener('beforeunload', function () { synth.cancel(); });
      }

      const shareButton = document.querySelector('[data-reader-share]');
      if (shareButton) shareButton.addEventListener('click', async function () {
        const shareData = { title: articleItem.title, url: window.location.href };
        try {
          if (navigator.share) await navigator.share(shareData);
          else if (navigator.clipboard && navigator.clipboard.writeText) {
            await navigator.clipboard.writeText(shareData.url);
            showStatus('Article link copied.');
          } else showStatus('Sharing is not available in this browser.');
        } catch (error) {
          if (error && error.name !== 'AbortError') showStatus('Could not share this article.');
        }
      });

    })();
  </script>
</body>
</html>









