<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} | The Global Desk</title>
  <meta name="description" content="{{ description or title }}">
  <meta name="theme-color" content="#08295f">
  <meta property="og:site_name" content="The Global Desk">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="canonical" href="https://thegdesk.com{{ page.url }}">
  {% if image %}
  <meta property="og:image" content="https://thegdesk.com{{ image }}">
  {% endif %}
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description or title }}">
  <meta property="og:type" content="article">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Libre+Franklin:wght@500;600;700;800;900&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700;8..60,800;8..60,900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/homepage.css">
  <style>
    .gd-article-page{padding-top:2rem;padding-bottom:4rem;max-width:900px}
    .gd-article-breadcrumb{font-size:.78rem;color:#767676;margin-bottom:1.5rem}
    .gd-article-breadcrumb a{color:#00205F;font-weight:700}
    .gd-article-category{display:inline-block;color:#B8871A;font-size:.75rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase;margin-bottom:.7rem}
    .gd-article-title{font-family:var(--gd-font-serif);font-size:clamp(2rem,5vw,3.6rem);line-height:1.13;letter-spacing:-.035em;color:#141414;margin:0 0 1rem}
    .gd-article-description{font-size:1.12rem;line-height:1.65;color:#555;margin:0 0 1.3rem;max-width:780px}
    .gd-article-meta{display:flex;flex-wrap:wrap;gap:.5rem 1rem;align-items:center;border-top:1px solid #e5e5e5;border-bottom:1px solid #e5e5e5;padding:.9rem 0;margin:1.3rem 0 1.6rem;font-size:.78rem;color:#767676}
    .gd-article-meta strong{color:#222}
    .gd-article-image{width:100%;max-height:560px;object-fit:cover;margin:0 0 2rem;background:#f4f4f4}
    .gd-article-body{font-family:var(--gd-font-serif);font-size:1.16rem;line-height:1.85;color:#252525;max-width:760px;margin:0 auto}
    .gd-article-body p{margin:0 0 1.35em}
    .gd-article-body h2,.gd-article-body h3{font-family:var(--gd-font);line-height:1.3;margin:1.8em 0 .7em;color:#141414}
    .gd-article-body h2{font-size:1.55rem}.gd-article-body h3{font-size:1.25rem}
    .gd-article-body a{color:#00205F;text-decoration:underline}
    .gd-article-body blockquote{border-left:4px solid #DFA321;padding:.5rem 1.2rem;margin:1.5rem 0;color:#555}
    .gd-article-body img{height:auto;margin:1.5rem auto}
    .gd-article-body ul,.gd-article-body ol{padding-left:1.5rem;list-style:revert;margin:0 0 1.3em}
    .gd-article-body li{margin:.4em 0}
    .gd-article-back{display:inline-block;margin-top:2.5rem;color:#00205F;font-size:.85rem;font-weight:800}
    @media(max-width:700px){.gd-article-page{padding-top:1.4rem}.gd-article-title{font-size:2.15rem}.gd-article-description{font-size:1rem}.gd-article-body{font-size:1.08rem}}

  /* ==========================================
     THE GLOBAL DESK — PREMIUM ARTICLE DESIGN
  ========================================== */

  .gd-article-page {
    max-width: 1100px;
    padding: 38px 28px 90px;
  }

  .gd-article-breadcrumb {
    font-size: 12px;
    color: #777;
    margin-bottom: 34px;
    letter-spacing: .02em;
  }

  .gd-article-breadcrumb a {
    color: #09264b;
    text-decoration: none;
  }

  .gd-article-page > article > header {
    max-width: 920px;
    margin: 0 auto;
  }

  .gd-article-category {
    display: inline-block;
    color: #a77b20;
    font-family: var(--gd-font);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .13em;
    text-transform: uppercase;
    margin-bottom: 17px;
  }

  .gd-article-title {
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: clamp(38px, 5.2vw, 64px);
    font-weight: 800;
    line-height: 1.09;
    letter-spacing: -.045em;
    color: #101820;
    margin: 0 0 22px;
    max-width: 900px;
  }

  .gd-article-description {
    max-width: 820px;
    font-family: 'Inter', sans-serif;
    font-size: clamp(17px, 2vw, 21px);
    line-height: 1.65;
    color: #555e68;
    margin: 0 0 27px;
  }

  .gd-article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 22px;
    border-top: 1px solid #e5e7eb;
    border-bottom: 1px solid #e5e7eb;
    padding: 17px 0;
    margin: 0 0 30px;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    color: #747b84;
  }

  .gd-article-meta strong {
    color: #172333;
    font-weight: 700;
  }

  .gd-article-image {
    display: block;
    width: 100%;
    max-height: 620px;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin: 0 auto 44px;
    background: #f0f1f2;
  }

  .gd-article-body {
    max-width: 740px;
    margin: 0 auto;
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: 19px;
    line-height: 1.9;
    color: #292e35;
  }

  .gd-article-body p {
    margin: 0 0 1.55em;
  }

  .gd-article-body h2 {
    font-family: 'Inter', sans-serif;
    font-size: 29px;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -.025em;
    color: #101820;
    margin: 2em 0 .75em;
  }

  .gd-article-body h3 {
    font-family: 'Inter', sans-serif;
    font-size: 22px;
    font-weight: 700;
    line-height: 1.35;
    color: #172333;
    margin: 1.8em 0 .7em;
  }

  .gd-article-body a {
    color: #123e70;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .gd-article-body blockquote {
    border-left: 4px solid #c5a447;
    padding: 8px 0 8px 24px;
    margin: 2em 0;
    color: #555e68;
    font-size: 21px;
    line-height: 1.65;
  }

  .gd-article-body img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 2em auto;
  }

  .gd-article-body ul,
  .gd-article-body ol {
    padding-left: 1.5rem;
    margin: 0 0 1.5em;
  }

  .gd-article-body li {
    margin: .55em 0;
  }

  .gd-article-back {
    display: inline-block;
    margin-top: 55px;
    padding-top: 18px;
    border-top: 1px solid #e5e7eb;
    color: #123e70;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
  }

  @media (max-width: 700px) {
    .gd-article-page {
      padding: 24px 18px 60px;
    }

    .gd-article-breadcrumb {
      margin-bottom: 25px;
    }

    .gd-article-title {
      font-size: clamp(34px, 9vw, 44px);
      line-height: 1.12;
      letter-spacing: -.035em;
    }

    .gd-article-description {
      font-size: 16px;
      line-height: 1.65;
    }

    .gd-article-meta {
      padding: 14px 0;
      margin-bottom: 22px;
    }

    .gd-article-image {
      aspect-ratio: 4 / 3;
      margin-bottom: 30px;
    }

    .gd-article-body {
      font-size: 17px;
      line-height: 1.85;
    }

    .gd-article-body h2 {
      font-size: 25px;
    }

    .gd-article-body h3 {
      font-size: 20px;
    }
  }


  /* ARTICLE HEADLINE REFINEMENT */
  .gd-article-title {
    font-size: clamp(34px, 4.6vw, 56px);
  }

  .gd-article-image {
    margin-bottom: 0;
  }

  .gd-article-image-caption {
    max-width: 1100px;
    margin: 10px 0 40px;
    color: #858585;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    line-height: 1.5;
  }

  @media (max-width: 700px) {
    .gd-article-title {
      font-size: clamp(30px, 8vw, 38px);
    }

    .gd-article-image-caption {
      margin: 8px 0 28px;
      font-size: 10px;
    }
  }


  /* BBC STYLE TYPOGRAPHY REFINEMENT */

  .gd-article-page {
    max-width: 1000px;
    padding: 32px 24px 76px;
  }

  .gd-article-page > article > header {
    max-width: 820px;
    margin: 0 auto 26px;
  }

  .gd-article-title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(30px, 3.2vw, 42px);
    line-height: 1.16;
    letter-spacing: -0.025em;
    font-weight: 700;
    color: #111;
    margin: 14px 0 18px;
  }

  .gd-article-description {
    font-size: 18px;
    line-height: 1.55;
    font-weight: 400;
    color: #444;
    max-width: 760px;
  }

  .gd-article-image {
    display: block;
    width: 100%;
    max-height: 540px;
    object-fit: cover;
    margin-bottom: 0;
  }

  .gd-article-image-caption {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 9px 0 34px;
    font-family: Arial, sans-serif;
    font-size: 12px;
    line-height: 1.45;
    color: #555;
  }

  .gd-image-caption-text {
    color: #555;
    font-size: 12px;
  }

  .gd-image-credit {
    color: #777;
    font-size: 11px;
  }

  .gd-article-body {
    max-width: 680px;
    margin: 0 auto;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.65;
    letter-spacing: 0;
    color: #222;
  }

  .gd-article-body p {
    margin: 0 0 1.25em;
    font-weight: 400;
  }

  .gd-article-body h2 {
    font-size: 27px;
    line-height: 1.3;
    margin: 1.7em 0 .65em;
  }

  .gd-article-body h3 {
    font-size: 22px;
    line-height: 1.35;
  }

  @media (max-width: 700px) {
    .gd-article-page {
      padding: 24px 18px 54px;
    }

    .gd-article-title {
      font-size: 31px;
      line-height: 1.17;
    }

    .gd-article-description {
      font-size: 16px;
      line-height: 1.55;
    }

    .gd-article-body {
      font-size: 17px;
      line-height: 1.7;
    }

    .gd-article-body h2 {
      font-size: 24px;
    }

    .gd-article-image-caption {
      margin-bottom: 26px;
    }
  }

  .gd-article-body { font-size: var(--gd-reader-font-size, 18px) !important; }
  .gd-reader-tools {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: .65rem;
    max-width: 820px;
    margin: 1.4rem auto 1.7rem;
    padding: .55rem 0;
    border-top: 1px solid #dce2e8;
    border-bottom: 1px solid #dce2e8;
    font-family: 'Inter', sans-serif;
    overflow-x: auto;
    scrollbar-width: thin;
  }
  .gd-reader-tools__group { display: inline-flex; flex: 0 0 auto; align-items: center; gap: .3rem; margin-inline: .2rem; }
  .gd-reader-tools__label { color: #47596b; font-size: .72rem; font-weight: 750; }
  .gd-reader-tools button,
  .gd-reader-tools select,
  .gd-reader-tools__saved-link {
    display: inline-flex;
    flex: 0 0 auto;
    min-width: 36px;
    min-height: 36px;
    align-items: center;
    justify-content: center;
    gap: .35rem;
    padding: .35rem .48rem;
    border: 1px solid #c7d0d9;
    border-radius: 3px;
    background: #fff;
    color: #17304b;
    font: inherit;
    font-size: .72rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
  }
  .gd-reader-tools svg { width: 17px; height: 17px; flex: 0 0 17px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .gd-reader-tools [data-reader-font] { min-width: 35px; font-size: .82rem; }
  .gd-reader-tools__translate { display: inline-flex; flex: 0 0 auto; align-items: center; gap: .35rem; margin-inline: .2rem; }
  .gd-reader-tools__translate select { width: 94px; min-width: 94px; max-width: 94px; padding-right: .25rem; }
  .gd-reader-tools__status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; }
  .gd-reader-tools button:hover,
  .gd-reader-tools__saved-link:hover { border-color: #12375f; background: #f2f6f9; }
  .gd-reader-tools button[aria-pressed="true"] { border-color: #12375f; background: #12375f; color: #fff; }
  .gd-reader-tools :focus-visible,
  .gd-related-stories a:focus-visible { outline: 3px solid #c49632; outline-offset: 3px; }
  body[data-article-slug] .gd-article-page { width: 100%; max-width: 840px; }
  body[data-article-slug] .gd-article-body { max-width: 660px; }
  .gd-related-stories { margin: 3rem auto 0; padding-top: 1.65rem; border-top: 1px solid #dce2e8; }
  .gd-related-stories__heading > span { color: #8c6617; font: 800 .72rem/1.3 'Inter',sans-serif; letter-spacing: .1em; text-transform: uppercase; }
  .gd-related-stories__heading h2 { margin: .35rem 0 1rem; color: #17304b; font: 750 clamp(1.5rem,3vw,2rem)/1.2 Georgia,serif; }
  .gd-related-stories__grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1rem; }
  .gd-related-story { min-width: 0; border: 1px solid #dce2e8; background: #fff; }
  .gd-related-story > a { display: flex; height: 100%; flex-direction: column; padding: 1rem; color: inherit; text-decoration: none; }
  .gd-related-story > a:hover { background: #f6f8fa; }
  .gd-related-story__category { color: #8c6617; font: 800 .7rem/1.3 'Inter',sans-serif; letter-spacing: .07em; text-transform: uppercase; }
  .gd-related-story h3 { margin: .45rem 0; color: #17304b; font: 700 1.13rem/1.3 Georgia,serif; }
  .gd-related-story p { display: -webkit-box; overflow: hidden; margin: 0 0 .65rem; color: #526273; font: .84rem/1.5 'Inter',sans-serif; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
  .gd-related-story__date { margin-top: auto; color: #758292; font: 650 .72rem/1.4 'Inter',sans-serif; }
  .gd-related-stories__empty { color: #526273; line-height: 1.6; }
  .gd-related-stories__empty a { color: #12375f; font-weight: 750; }
  @media (max-width: 760px) {
    .gd-reader-tools { gap: .55rem; }
    .gd-reader-tools__label { display: none; }
    .gd-reader-tools__translate select { width: 82px; min-width: 82px; max-width: 82px; }
    .gd-related-stories__grid { grid-template-columns: minmax(0,1fr); }
  }

</style>
</head>
<body data-local-menu-init="true" data-article-slug="{{ page.fileSlug }}" data-article-title="{{ title | escape }}" data-article-category="{{ category | escape }}" data-article-url="{{ page.url }}">

{% include 'global-header.njk' %}


  <main class="gd-container gd-article-page">
    <div class="gd-article-breadcrumb"><a href="/">Home</a> / <span>{{ category or "News" }}</span></div>

    <article>
      <header>
        <span class="gd-article-category">{{ category or "News" }}</span>
        <h1 class="gd-article-title">{{ title }}</h1>
        {% if description %}
        <p class="gd-article-description">{{ description }}</p>
        {% endif %}
        <div class="gd-article-meta">
          {% if author %}<span>By <strong>{{ author }}</strong></span>{% endif %}
          {% if date %}<time datetime="{{ date | readableDate }}">{{ date | readableDate }}</time>{% endif %}
          <span>The Global Desk</span>
          <span id="gd-reading-time" data-reading-time>Calculating reading time…</span>
        </div>
      </header>

      {% if image %}
      <img class="gd-article-image" src="{{ image }}" alt="{{ title }}">
      {% if imageCaption or imageCredit %}
      <div class="gd-article-image-caption">
        {% if imageCaption %}
        <span class="gd-image-caption-text">{{ imageCaption }}</span>
        {% endif %}
        {% if imageCredit %}
        <span class="gd-image-credit">{{ imageCredit }}</span>
        {% endif %}
      </div>
      {% endif %}
      {% endif %}

      <div class="gd-reader-tools" role="toolbar" aria-label="Article reading tools">
        <button type="button" data-reader-share aria-label="Share article" title="Share article"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V3M7.5 7.5 12 3l4.5 4.5"/><path d="M5 12v7h14v-7"/></svg></button>
        <div class="gd-reader-tools__group" role="group" aria-label="Text size">
          <button type="button" data-reader-font="down" aria-label="Decrease article text size" title="Decrease text size">A−</button>
          <button type="button" data-reader-font="up" aria-label="Increase article text size" title="Increase text size">A+</button>
        </div>
        <button type="button" data-reader-listen aria-label="Listen to article" title="Listen to article"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10v4h4l5 4V6l-5 4z"/><path d="M17 9a5 5 0 0 1 0 6M19.5 6.5a9 9 0 0 1 0 11"/></svg></button>
        <button type="button" data-reader-save aria-label="Save for later" title="Save for later" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4.5h12v16l-6-4-6 4z"/></svg></button>
        <label class="gd-reader-tools__translate" for="gd-translate-language" aria-label="Translate article">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3.5 12h17M12 3c2.4 2.4 3.5 5.4 3.5 9s-1.1 6.6-3.5 9c-2.4-2.4-3.5-5.4-3.5-9S9.6 5.4 12 3z"/></svg>
          <select id="gd-translate-language" data-translate-language>
            <option value="">Choose language</option>
            <option value="bn">বাংলা</option>
            <option value="hi">हिन्दी</option>
            <option value="ur">اردو</option>
            <option value="ar">العربية</option>
            <option value="es">Español</option>
            <option value="fr">Français</option>
            <option value="id">Bahasa Indonesia</option>
            <option value="zh-CN">简体中文</option>
          </select>
        </label>
        <button type="button" data-reader-translate aria-label="Open translation" title="Open translation"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h10M9 3v2c0 5-2.5 8-5 9M6 9c1 2 3 4 5 5M14 19l3.5-9 3.5 9M15.2 16h4.6"/></svg></button>
        <a class="gd-reader-tools__saved-link" href="/saved/" aria-label="Saved stories" title="Saved stories"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h14v16l-7-4-7 4z"/><path d="M8 8h8"/></svg></a>
        <span class="gd-reader-tools__status" data-reader-status role="status" aria-live="polite"></span>
      </div>

      <div class="gd-article-body">
        {{ content | safe }}
      </div>
    </article>

    {% set relatedItems = collections.publishedNews | relatedNews(page.url, category, 3) %}
    <section class="gd-related-stories" aria-labelledby="gd-related-title">
      <div class="gd-related-stories__heading">
        <span>Keep reading</span>
        <h2 id="gd-related-title">Related stories</h2>
      </div>
      {% if relatedItems.length %}
      <div class="gd-related-stories__grid">
        {% for item in relatedItems %}
        <article class="gd-related-story">
          <a href="{{ item.url }}">
            <span class="gd-related-story__category">{{ item.data.category or "News" }}</span>
            <h3>{{ item.data.title }}</h3>
            {% if item.data.description %}<p>{{ item.data.description }}</p>{% endif %}
            <span class="gd-related-story__date">{{ item.date | readableDate }}</span>
          </a>
        </article>
        {% endfor %}
      </div>
      {% else %}
      <p class="gd-related-stories__empty">More coverage is coming soon. <a href="/search/">Browse all stories</a>.</p>
      {% endif %}
    </section>

    <a class="gd-article-back" href="/">‹ Back</a>
  </main>

  {% include 'global-footer.njk' %}

  <script>
    // Homepage-style date
    (function () {
      const dateEl = document.getElementById('gd-topbar-date');
      if (dateEl) {
        const d = new Date();
        dateEl.textContent = d.toLocaleDateString('en-GB', {
          day: 'numeric',
          month: 'long',
          year: 'numeric'
        });
      }
    })();

    // Homepage mobile navigation
    const menuBtn = document.getElementById('gd-menu-btn');
    const nav = document.getElementById('gd-nav');

    function setMenu(open) {
      if (!menuBtn || !nav) return;
      nav.classList.toggle('is-open', open);
      menuBtn.classList.toggle('is-open', open);
      menuBtn.setAttribute('aria-expanded', String(open));
      menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      document.body.classList.toggle('gd-menu-active', open);
      document.body.style.overflow = open ? 'hidden' : '';
    }

    if (menuBtn && nav) {
      menuBtn.setAttribute('aria-expanded', 'false');

      menuBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        setMenu(!nav.classList.contains('is-open'));
      });

      document.addEventListener('click', function (e) {
        if (window.innerWidth <= 768 &&
            nav.classList.contains('is-open') &&
            !nav.contains(e.target) &&
            !menuBtn.contains(e.target)) {
          setMenu(false);
        }
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && nav.classList.contains('is-open')) {
          setMenu(false);
          menuBtn.focus();
        }
      });

      window.addEventListener('resize', function () {
        if (window.innerWidth > 768) setMenu(false);
      });

      nav.addEventListener('click', function (e) {
        const toggle = e.target.closest('.gd-nav__dropdown-toggle');
        if (!toggle || window.innerWidth > 768) return;

        e.preventDefault();
        e.stopPropagation();

        const parent = toggle.closest('.gd-nav__dropdown');
        if (!parent) return;

        const willOpen = !parent.classList.contains('is-open');

        nav.querySelectorAll('.gd-nav__dropdown.is-open').forEach(function (item) {
          item.classList.remove('is-open');
          const itemToggle = item.querySelector('.gd-nav__dropdown-toggle');
          if (itemToggle) itemToggle.setAttribute('aria-expanded', 'false');
        });

        if (willOpen) {
          parent.classList.add('is-open');
          toggle.setAttribute('aria-expanded', 'true');
        }
      });

      nav.querySelectorAll('.gd-nav__dropdown-toggle').forEach(function (toggle) {
        toggle.setAttribute('role', 'button');
        toggle.setAttribute('tabindex', '0');
        toggle.setAttribute('aria-expanded', 'false');

        toggle.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            toggle.click();
          }
        });
      });
    }

    // Preserve article view counter
    (function () {
      const slug = document.body.dataset.articleSlug;
      if (slug) {
        fetch('/api/views', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug: slug }),
          keepalive: true
        }).catch(function () {});
      }
    })();

    // Reader controls: reading time, text size, contrast, audio, saves, and translation.
    (function () {
      const articleBody = document.querySelector('.gd-article-body');
      const status = document.querySelector('[data-reader-status]');
      const savedKey = 'tgd-saved-stories-v1';
      const fontKey = 'tgd-reader-font-size-v1';
      const showStatus = function (message) {
        if (status) status.textContent = message;
      };
      const readSaved = function () {
        try {
          const items = JSON.parse(localStorage.getItem(savedKey) || '[]');
          return Array.isArray(items) ? items.filter(function (item) {
            return item && typeof item.url === 'string' && typeof item.title === 'string';
          }) : [];
        } catch (error) { return []; }
      };
      const store = function (key, value) {
        try { localStorage.setItem(key, value); return true; } catch (error) { return false; }
      };

      if (!articleBody) return;

      const readingTime = document.querySelector('[data-reading-time]');
      const wordCount = (articleBody.innerText || articleBody.textContent || '').trim().split(/\s+/).filter(Boolean).length;
      if (readingTime) readingTime.textContent = Math.max(1, Math.ceil(wordCount / 200)) + ' min read';

      let fontSize = 18;
      try {
        const storedSize = Number(localStorage.getItem(fontKey));
        if (storedSize >= 16 && storedSize <= 26) fontSize = storedSize;
      } catch (error) {}
      const applyFontSize = function () {
        articleBody.style.setProperty('--gd-reader-font-size', fontSize + 'px');
      };
      applyFontSize();
      document.querySelectorAll('[data-reader-font]').forEach(function (button) {
        button.addEventListener('click', function () {
          fontSize = Math.max(16, Math.min(26, fontSize + (button.dataset.readerFont === 'up' ? 2 : -2)));
          applyFontSize();
          store(fontKey, String(fontSize));
          showStatus('Article text size: ' + fontSize + ' pixels.');
        });
      });

      const saveButton = document.querySelector('[data-reader-save]');
      const articleUrl = new URL(document.body.dataset.articleUrl || window.location.pathname, window.location.origin).pathname;
      const articleItem = {
        url: articleUrl,
        title: document.body.dataset.articleTitle || document.querySelector('.gd-article-title')?.textContent.trim() || 'The Global Desk story',
        category: document.body.dataset.articleCategory || 'News'
      };
      const updateSaveButton = function () {
        const isSaved = readSaved().some(function (item) { return item.url === articleItem.url; });
        if (saveButton) {
          saveButton.setAttribute('aria-pressed', String(isSaved));
          saveButton.setAttribute('aria-label', isSaved ? 'Remove from saved stories' : 'Save for later');
          saveButton.title = isSaved ? 'Remove from saved stories' : 'Save for later';
        }
      };
      updateSaveButton();
      if (saveButton) saveButton.addEventListener('click', function () {
        const items = readSaved();
        const index = items.findIndex(function (item) { return item.url === articleItem.url; });
        if (index >= 0) {
          items.splice(index, 1);
          if (store(savedKey, JSON.stringify(items))) showStatus('Removed from saved stories.');
          else showStatus('This browser could not update your saved stories.');
        } else {
          items.unshift(Object.assign({ savedAt: new Date().toISOString() }, articleItem));
          if (store(savedKey, JSON.stringify(items.slice(0, 100)))) showStatus('Saved on this device. Open Saved stories to find it later.');
          else showStatus('This browser could not save the story.');
        }
        updateSaveButton();
      });

      const listenButton = document.querySelector('[data-reader-listen]');
      const synth = window.speechSynthesis;
      if (!synth || !window.SpeechSynthesisUtterance) {
        if (listenButton) listenButton.hidden = true;
      } else {
        const resetAudioControls = function () {
          if (listenButton) {
            listenButton.setAttribute('aria-label', 'Listen to article');
            listenButton.title = 'Listen to article';
            listenButton.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10v4h4l5 4V6l-5 4z"/><path d="M17 9a5 5 0 0 1 0 6M19.5 6.5a9 9 0 0 1 0 11"/></svg>';
          }
        };
        if (listenButton) listenButton.addEventListener('click', function () {
          if (synth.speaking && synth.paused) {
            synth.resume();
            listenButton.setAttribute('aria-label', 'Pause audio'); listenButton.title = 'Pause audio';
            showStatus('Audio resumed.');
            return;
          }
          if (synth.speaking) {
            synth.pause();
            listenButton.setAttribute('aria-label', 'Resume audio'); listenButton.title = 'Resume audio';
            showStatus('Audio paused.');
            return;
          }
          const utterance = new SpeechSynthesisUtterance(articleBody.innerText || articleBody.textContent || '');
          utterance.lang = document.documentElement.lang || 'en';
          utterance.rate = 1;
          utterance.onstart = function () {
            listenButton.setAttribute('aria-label', 'Pause audio'); listenButton.title = 'Pause audio';
            showStatus('Reading the article aloud.');
          };
          utterance.onend = function () { resetAudioControls(); showStatus('Audio finished.'); };
          utterance.onerror = function () { resetAudioControls(); showStatus('Audio could not play in this browser.'); };
          synth.cancel();
          synth.speak(utterance);
        });
        window.addEventListener('beforeunload', function () { synth.cancel(); });
      }

      const shareButton = document.querySelector('[data-reader-share]');
      if (shareButton) shareButton.addEventListener('click', async function () {
        const shareData = { title: articleItem.title, url: window.location.href };
        try {
          if (navigator.share) await navigator.share(shareData);
          else if (navigator.clipboard && navigator.clipboard.writeText) {
            await navigator.clipboard.writeText(shareData.url);
            showStatus('Article link copied.');
          } else showStatus('Sharing is not available in this browser.');
        } catch (error) {
          if (error && error.name !== 'AbortError') showStatus('Could not share this article.');
        }
      });

      const translateButton = document.querySelector('[data-reader-translate]');
      const languageSelect = document.querySelector('[data-translate-language]');
      if (translateButton && languageSelect) translateButton.addEventListener('click', function () {
        const language = languageSelect.value;
        if (!language) {
          showStatus('Choose a language first.');
          languageSelect.focus();
          return;
        }
        const translateUrl = new URL('https://translate.google.com/translate');
        translateUrl.searchParams.set('sl', 'auto');
        translateUrl.searchParams.set('tl', language);
        translateUrl.searchParams.set('u', window.location.href);
        window.open(translateUrl.toString(), '_blank', 'noopener,noreferrer');
        showStatus('Opening Google Translate in a new tab.');
      });
    })();
  </script>
</body>
</html>









