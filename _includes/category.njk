<!DOCTYPE html>
<html lang="en">
<head>
  {% set listingTitle = title %}
  {% set listingDescription = description %}
  {% if categoryPage %}
    {% set listingTitle = categoryPage.title %}
    {% set listingDescription = "Latest news, reports and developments from " ~ categoryPage.title ~ "." %}
  {% elif sectionPage %}
    {% set listingTitle = sectionPage.title %}
    {% set listingDescription = "Latest stories and coverage from " ~ sectionPage.title ~ "." %}
  {% endif %}
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ listingTitle }} | The Global Desk</title>
  <meta name="description" content="{{ listingDescription or listingTitle }}">
  <meta name="theme-color" content="#08295f">
  <meta property="og:site_name" content="The Global Desk">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="canonical" href="https://thegdesk.com{{ page.url }}">
  {% if image %}
  <meta property="og:image" content="https://thegdesk.com{{ image }}">
  {% endif %}
  <meta property="og:title" content="{{ listingTitle }}">
  <meta property="og:description" content="{{ listingDescription or listingTitle }}">
  <meta property="og:type" content="article">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Libre+Franklin:wght@500;600;700;800;900&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700;8..60,800;8..60,900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/homepage.css?v=20261126-category-grid-consistency">
  <style>
    .gd-article-page{padding-top:2rem;padding-bottom:4rem;max-width:900px}
    .gd-article-breadcrumb{font-family:'Inter',sans-serif;font-size:1rem;line-height:1.5;color:#64748b;margin:0 0 1.6rem}
    .gd-article-breadcrumb a{color:#12375f;font-weight:750;text-decoration:none}
    .gd-article-breadcrumb a:hover{text-decoration:underline}
    .gd-article-category{display:inline-block;color:#B8871A;font-size:.75rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase;margin-bottom:.7rem}
    .gd-article-title{font-family:var(--gd-font-serif);font-size:clamp(2rem,5vw,3.6rem);line-height:1.13;letter-spacing:-.035em;color:#141414;margin:0 0 1rem}
    .gd-article-description{font-size:1.12rem;line-height:1.65;color:#555;margin:0 0 1.3rem;max-width:780px}
    .gd-article-meta{display:flex;flex-wrap:wrap;gap:.5rem 1rem;align-items:center;border-top:1px solid #e5e5e5;border-bottom:1px solid #e5e5e5;padding:.9rem 0;margin:1.3rem 0 1.6rem;font-size:.78rem;color:#767676}
    .gd-article-meta strong{color:#222}
    .gd-article-image{width:100%;max-height:560px;object-fit:cover;margin:0 0 2rem;background:#f4f4f4}
    .gd-article-body{font-family:var(--gd-font-serif);font-size:1.16rem;line-height:1.85;color:#252525;max-width:760px;margin:0 auto}
    .gd-article-body p{margin:0 0 1.35em}
    .gd-article-body h2,.gd-article-body h3{font-family:var(--gd-font);line-height:1.3;margin:1.8em 0 .7em;color:#141414}
    .gd-article-body h2{font-size:1.55rem}.gd-article-body h3{font-size:1.25rem}
    .gd-article-body a{color:#00205F;text-decoration:underline}
    .gd-article-body blockquote{border-left:4px solid #DFA321;padding:.5rem 1.2rem;margin:1.5rem 0;color:#555}
    .gd-article-body img{height:auto;margin:1.5rem auto}
    .gd-article-body ul,.gd-article-body ol{padding-left:1.5rem;list-style:revert;margin:0 0 1.3em}
    .gd-article-body li{margin:.4em 0}
    .gd-article-back{display:inline-block;margin-top:2.5rem;color:#00205F;font-size:.85rem;font-weight:800}
    @media(max-width:700px){.gd-article-page{padding-top:1.4rem}.gd-article-title{font-size:2.15rem}.gd-article-description{font-size:1rem}.gd-article-body{font-size:1.08rem}}
  </style>
</head>
<body data-local-menu-init="true">

{% include 'global-header.njk' %}


  {{ content | safe }}

  {% include 'global-footer.njk' %}

  <script>
    // Homepage mobile navigation
    const menuBtn = document.getElementById('gd-menu-btn');
    const nav = document.getElementById('gd-nav');

    function setMenu(open) {
      if (!menuBtn || !nav) return;
      nav.classList.toggle('is-open', open);
      menuBtn.classList.toggle('is-open', open);
      menuBtn.setAttribute('aria-expanded', String(open));
      menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      document.body.classList.toggle('gd-menu-active', open);
      document.body.style.overflow = open ? 'hidden' : '';
    }

    if (menuBtn && nav) {
      menuBtn.setAttribute('aria-expanded', 'false');

      menuBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        setMenu(!nav.classList.contains('is-open'));
      });

      document.addEventListener('click', function (e) {
        if (window.innerWidth <= 768 &&
            nav.classList.contains('is-open') &&
            !nav.contains(e.target) &&
            !menuBtn.contains(e.target)) {
          setMenu(false);
        }
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && nav.classList.contains('is-open')) {
          setMenu(false);
          menuBtn.focus();
        }
      });

      window.addEventListener('resize', function () {
        if (window.innerWidth > 768) setMenu(false);
      });

      nav.addEventListener('click', function (e) {
        const toggle = e.target.closest('.gd-nav__dropdown-toggle');
        if (!toggle || window.innerWidth > 768) return;

        e.preventDefault();
        e.stopPropagation();

        const parent = toggle.closest('.gd-nav__dropdown');
        if (!parent) return;

        const willOpen = !parent.classList.contains('is-open');

        nav.querySelectorAll('.gd-nav__dropdown.is-open').forEach(function (item) {
          item.classList.remove('is-open');
          const itemToggle = item.querySelector('.gd-nav__dropdown-toggle');
          if (itemToggle) itemToggle.setAttribute('aria-expanded', 'false');
        });

        if (willOpen) {
          parent.classList.add('is-open');
          toggle.setAttribute('aria-expanded', 'true');
        }
      });

      nav.querySelectorAll('.gd-nav__dropdown-toggle').forEach(function (toggle) {
        toggle.setAttribute('role', 'button');
        toggle.setAttribute('tabindex', '0');
        toggle.setAttribute('aria-expanded', 'false');

        toggle.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            toggle.click();
          }
        });
      });
    }

    // Preserve article view counter
    (function () {
      const slug = document.body.dataset.articleSlug;
      if (slug) {
        fetch('/api/views', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug: slug }),
          keepalive: true
        }).catch(function () {});
      }
    })();
  </script>
  <script>
    (function () {
      const items = document.querySelectorAll('[data-relative-time][datetime]');
      const dateFormat = new Intl.DateTimeFormat('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
      function updateTimes() {
        const now = Date.now();
        items.forEach(function (item) {
          const published = new Date(item.dateTime).getTime();
          if (!Number.isFinite(published)) return;
          const minutes = Math.floor((now - published) / 60000);
          if (minutes < 0) { item.textContent = dateFormat.format(new Date(published)); return; }
          if (minutes < 1) { item.textContent = 'Just now'; return; }
          if (minutes < 60) { item.textContent = minutes + (minutes === 1 ? ' minute ago' : ' minutes ago'); return; }
          const hours = Math.floor(minutes / 60);
          if (hours < 24) { item.textContent = hours + (hours === 1 ? ' hour ago' : ' hours ago'); return; }
          const days = Math.floor(hours / 24);
          item.textContent = days < 7 ? days + (days === 1 ? ' day ago' : ' days ago') : dateFormat.format(new Date(published));
        });
      }
      updateTimes();
      window.setInterval(updateTimes, 60000);
    })();
  </script>
</body>
</html>





