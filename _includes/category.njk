<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} | The Global Desk</title>
  <meta name="description" content="{{ description or title }}">
  <meta name="theme-color" content="#08295f">
  <meta property="og:site_name" content="The Global Desk">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="canonical" href="https://thegdesk.com{{ page.url }}">
  {% if image %}
  <meta property="og:image" content="https://thegdesk.com{{ image }}">
  {% endif %}
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description or title }}">
  <meta property="og:type" content="article">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Libre+Franklin:wght@500;600;700;800;900&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700;8..60,800;8..60,900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/homepage.css">
  <style>
    .gd-article-page{padding-top:2rem;padding-bottom:4rem;max-width:900px}
    .gd-article-breadcrumb{font-size:.78rem;color:#767676;margin-bottom:1.5rem}
    .gd-article-breadcrumb a{color:#00205F;font-weight:700}
    .gd-article-category{display:inline-block;color:#B8871A;font-size:.75rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase;margin-bottom:.7rem}
    .gd-article-title{font-family:var(--gd-font-serif);font-size:clamp(2rem,5vw,3.6rem);line-height:1.13;letter-spacing:-.035em;color:#141414;margin:0 0 1rem}
    .gd-article-description{font-size:1.12rem;line-height:1.65;color:#555;margin:0 0 1.3rem;max-width:780px}
    .gd-article-meta{display:flex;flex-wrap:wrap;gap:.5rem 1rem;align-items:center;border-top:1px solid #e5e5e5;border-bottom:1px solid #e5e5e5;padding:.9rem 0;margin:1.3rem 0 1.6rem;font-size:.78rem;color:#767676}
    .gd-article-meta strong{color:#222}
    .gd-article-image{width:100%;max-height:560px;object-fit:cover;margin:0 0 2rem;background:#f4f4f4}
    .gd-article-body{font-family:var(--gd-font-serif);font-size:1.16rem;line-height:1.85;color:#252525;max-width:760px;margin:0 auto}
    .gd-article-body p{margin:0 0 1.35em}
    .gd-article-body h2,.gd-article-body h3{font-family:var(--gd-font);line-height:1.3;margin:1.8em 0 .7em;color:#141414}
    .gd-article-body h2{font-size:1.55rem}.gd-article-body h3{font-size:1.25rem}
    .gd-article-body a{color:#00205F;text-decoration:underline}
    .gd-article-body blockquote{border-left:4px solid #DFA321;padding:.5rem 1.2rem;margin:1.5rem 0;color:#555}
    .gd-article-body img{height:auto;margin:1.5rem auto}
    .gd-article-body ul,.gd-article-body ol{padding-left:1.5rem;list-style:revert;margin:0 0 1.3em}
    .gd-article-body li{margin:.4em 0}
    .gd-article-back{display:inline-block;margin-top:2.5rem;color:#00205F;font-size:.85rem;font-weight:800}
    @media(max-width:700px){.gd-article-page{padding-top:1.4rem}.gd-article-title{font-size:2.15rem}.gd-article-description{font-size:1rem}.gd-article-body{font-size:1.08rem}}
  </style>
</head>
<body>
  <div class="gd-topbar">
    <div class="gd-container gd-topbar__inner">
      <div class="gd-topbar__live-stack">
        <span class="gd-topbar__live">
          <span class="gd-topbar__green-dot"></span> Live
        </span>
        <span class="gd-topbar__edition">Global Edition</span>
      </div>
      <div class="gd-topbar__date" id="gd-topbar-date">Loading...</div>
    </div>
  </div>

  <header class="gd-header">
    <div class="gd-container gd-header__inner">
      <button class="gd-menu-btn" aria-label="Open menu" id="gd-menu-btn">
        <svg viewBox="0 0 34 24" width="34" height="24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <g class="gd-menu-btn__search">
            <path d="M1.8 6H9.8M1.8 12H11.5M1.8 18H13.5" stroke-width="2.1"/>
            <circle cx="22" cy="9" r="6.8" stroke-width="1.9"/>
            <path d="m26.8 13.8 4.7 4.7" stroke-width="2"/>
          </g>
          <g class="gd-menu-btn__close">
            <path d="m11 6 12 12M23 6 11 18" stroke-width="2.3"/>
          </g>
        </svg>
      </button>

      <a href="/" class="gd-logo">
        <img src="/images/Logo-header.png" alt="The Global Desk" class="gd-logo__img">
        <span class="gd-logo__text">The Global Desk</span>
      </a>

      <nav class="gd-nav" id="gd-nav">
        <form class="gd-mobile-search" action="/search/" method="get" role="search">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.3-4.3"/>
          </svg>
          <input type="search" name="q" placeholder="Search global news..." aria-label="Search global news">
          <button type="submit">Search</button>
        </form>
        <a href="/reader/sign-in/" class="gd-mobile-signin">Sign In</a>

        <a href="/">Home</a>

        <div class="gd-nav__dropdown">
          <span class="gd-nav__dropdown-toggle">World<span class="caret"></span></span>
          <div class="gd-nav__dropdown-menu gd-nav__dropdown-menu--world">
            <div class="gd-nav__group">
              <span class="gd-nav__group-label">Regions</span>
              <a href="/category/asia/">Asia</a>
              <a href="/category/europe/">Europe</a>
              <a href="/category/middle-east/">Middle East</a>
              <a href="/category/africa/">Africa</a>
              <a href="/category/americas/">Americas</a>
              <a href="/category/asia-pacific/">Asia-Pacific</a>
            </div>
            <div class="gd-nav__group">
              <span class="gd-nav__group-label">Global Affairs</span>
              <a href="/category/united-nations/">United Nations</a>
              <a href="/category/global-conflicts/">Global Conflicts</a>
              <a href="/category/climate-crisis/">Climate &amp; Environment</a>
              <a href="/category/global-health/">Global Health</a>
              <a href="/category/diplomacy/">Diplomacy</a>
            </div>
          </div>
        </div>

        <div class="gd-nav__dropdown">
          <span class="gd-nav__dropdown-toggle">Explainer<span class="caret"></span></span>
          <div class="gd-nav__dropdown-menu">
            <a href="/explainer/why-it-matters/">Why It Matters</a>
            <a href="/explainer/1-minute/">1-minute explainers</a>
          </div>
        </div>

        <div class="gd-nav__dropdown">
          <span class="gd-nav__dropdown-toggle">Opinion<span class="caret"></span></span>
          <div class="gd-nav__dropdown-menu">
            <a href="/opinion/editorials/">Editorials</a>
            <a href="/opinion/perspectives/">Perspectives</a>
          </div>
        </div>

        <div class="gd-nav__dropdown">
          <span class="gd-nav__dropdown-toggle">Explore<span class="caret"></span></span>
          <div class="gd-nav__dropdown-menu">
            <a href="/category/economy/">Economy</a>
            <a href="/category/politics/">Politics</a>
            <a href="/category/innovation/">Innovation</a>
            <a href="/category/earth/">Earth</a>
            <a href="/category/research/">Research</a>
            <a href="/category/feature-voices/">Featured Voices</a>
          </div>
        </div>
      </nav>

      <div class="gd-header__actions">
        <a href="/search/" class="gd-icon-btn" aria-label="Search">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.3-4.3"/>
          </svg>
        </a>
        <a href="/reader/sign-in/" class="gd-signin">Sign In</a>
      </div>
    </div>
  </header>

  {{ content | safe }}

  <footer class="gd-footer">
    <div class="gd-container">
      <div class="gd-footer__grid">
        <div class="gd-footer__brand">
          <img src="/images/Logo-header.png" alt="The Global Desk" class="gd-footer__logo">
          <p class="gd-footer__tagline">Interactive Global Intelligence &amp; News Platform</p>
        </div>
        <div>
          <h3 class="gd-footer__heading">Sections</h3>
          <ul class="gd-footer__list">
            <li><a href="/">Home</a></li><li><a href="/category/world/">World</a></li>
            <li><a href="/category/asia/">Asia</a></li><li><a href="/search/">Search</a></li>
          </ul>
        </div>
        <div>
          <h3 class="gd-footer__heading">Discover</h3>
          <ul class="gd-footer__list">
            <li><a href="/category/explainer/">Explainers</a></li>
            <li><a href="/category/environment/">Environment</a></li>
            <li><a href="/category/research/">Research</a></li>
          </ul>
        </div>
        <div>
          <h3 class="gd-footer__heading">About</h3>
          <ul class="gd-footer__list">
            <li><a href="/about/">About us</a></li>
            <li><a href="/contact/">Contact</a></li>
            <li><a href="/privacy/">Privacy</a></li>
          </ul>
        </div>
      </div>
      <div class="gd-footer__bottom"><span>&copy; 2026 The Global Desk. All rights reserved.</span></div>
    </div>
  </footer>

  <script>
    // Homepage-style date
    (function () {
      const dateEl = document.getElementById('gd-topbar-date');
      if (dateEl) {
        const d = new Date();
        dateEl.textContent = d.toLocaleDateString('en-GB', {
          day: 'numeric',
          month: 'long',
          year: 'numeric'
        });
      }
    })();

    // Homepage mobile navigation
    const menuBtn = document.getElementById('gd-menu-btn');
    const nav = document.getElementById('gd-nav');

    function setMenu(open) {
      if (!menuBtn || !nav) return;
      nav.classList.toggle('is-open', open);
      menuBtn.classList.toggle('is-open', open);
      menuBtn.setAttribute('aria-expanded', String(open));
      menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      document.body.classList.toggle('gd-menu-active', open);
      document.body.style.overflow = open ? 'hidden' : '';
    }

    if (menuBtn && nav) {
      menuBtn.setAttribute('aria-expanded', 'false');

      menuBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        setMenu(!nav.classList.contains('is-open'));
      });

      document.addEventListener('click', function (e) {
        if (window.innerWidth <= 768 &&
            nav.classList.contains('is-open') &&
            !nav.contains(e.target) &&
            !menuBtn.contains(e.target)) {
          setMenu(false);
        }
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && nav.classList.contains('is-open')) {
          setMenu(false);
          menuBtn.focus();
        }
      });

      window.addEventListener('resize', function () {
        if (window.innerWidth > 768) setMenu(false);
      });

      nav.addEventListener('click', function (e) {
        const toggle = e.target.closest('.gd-nav__dropdown-toggle');
        if (!toggle || window.innerWidth > 768) return;

        e.preventDefault();
        e.stopPropagation();

        const parent = toggle.closest('.gd-nav__dropdown');
        if (!parent) return;

        const willOpen = !parent.classList.contains('is-open');

        nav.querySelectorAll('.gd-nav__dropdown.is-open').forEach(function (item) {
          item.classList.remove('is-open');
          const itemToggle = item.querySelector('.gd-nav__dropdown-toggle');
          if (itemToggle) itemToggle.setAttribute('aria-expanded', 'false');
        });

        if (willOpen) {
          parent.classList.add('is-open');
          toggle.setAttribute('aria-expanded', 'true');
        }
      });

      nav.querySelectorAll('.gd-nav__dropdown-toggle').forEach(function (toggle) {
        toggle.setAttribute('role', 'button');
        toggle.setAttribute('tabindex', '0');
        toggle.setAttribute('aria-expanded', 'false');

        toggle.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            toggle.click();
          }
        });
      });
    }

    // Preserve article view counter
    (function () {
      const slug = document.body.dataset.articleSlug;
      if (slug) {
        fetch('/api/views', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug: slug }),
          keepalive: true
        }).catch(function () {});
      }
    })();
  </script>
</body>
</html>





