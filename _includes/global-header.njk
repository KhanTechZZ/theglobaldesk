<script>
(function () {
  var dateEl = document.getElementById('gd-topbar-date');
  if (dateEl) dateEl.textContent = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
  var button = document.getElementById('gd-menu-btn');
  var nav = document.getElementById('gd-nav');
  if (!button || !nav || document.body.dataset.localMenuInit === 'true') return;
  function setOpen(open) {
    nav.classList.toggle('is-open', open);
    button.classList.toggle('is-open', open);
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.body.classList.toggle('gd-menu-active', open);
    document.body.style.overflow = open ? 'hidden' : '';
  }
  button.setAttribute('aria-expanded', 'false');
  button.addEventListener('click', function () { setOpen(!nav.classList.contains('is-open')); });
  document.addEventListener('click', function (event) {
    if (window.innerWidth <= 768 && nav.classList.contains('is-open') && !nav.contains(event.target) && !button.contains(event.target)) setOpen(false);
  });
  document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape' && nav.classList.contains('is-open')) { setOpen(false); button.focus(); }
  });
  window.addEventListener('resize', function () { if (window.innerWidth > 768) setOpen(false); });
})();
</script>
