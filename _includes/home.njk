<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <title>The Global Desk | World News, Research & Global Analysis</title>
    <meta name="description" content="The Global Desk is an independent digital news platform headquartered in Dhaka, Bangladesh, covering South Asia, Asia and global affairs through news, research, in-depth analysis and next-generation editorial platforms.">
    <meta name="author" content="The Global Desk">
    <meta name="robots" content="index, follow">
    <meta name="theme-color" content="#071a33">
    <link rel="canonical" href="https://thegdesk.com/">

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-X1E8X103FR"></script>
    <script>window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', 'G-X1E8X103FR');</script>

    <meta property="og:type" content="website">
    <meta property="og:url" content="https://thegdesk.com/">
    <meta property="og:title" content="The Global Desk | World News, Research & Global Analysis">
    <meta property="og:description" content="Independent news, research and global analysis from Dhaka, Bangladesh, covering South Asia, Asia and the world.">
    <meta property="og:image" content="https://thegdesk.com/Logo.png">
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:title" content="The Global Desk | World News, Research & Global Analysis">
    <meta property="twitter:description" content="Independent news, research and global analysis from Dhaka, Bangladesh, covering South Asia, Asia and the world.">
    <meta property="twitter:image" content="https://thegdesk.com/Logo.png">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "NewsMediaOrganization",
      "@id": "https://thegdesk.com/#organization",
      "name": "The Global Desk",
      "url": "https://thegdesk.com/",
      "logo": {
        "@type": "ImageObject",
        "url": "https://thegdesk.com/Logo.png"
      },
      "foundingDate": "2026",
      "email": "contact@thegdesk.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Dhaka",
        "addressCountry": "BD"
      },
      "areaServed": ["South Asia", "Asia", "Worldwide"],
      "sameAs": [
        "https://facebook.com/thegdesk",
        "https://youtube.com/@thegdesk",
        "https://x.com/thegdeskHQ",
        "https://instagram.com/thegdesk",
        "https://tiktok.com/@thegdesk"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://thegdesk.com/#website",
      "url": "https://thegdesk.com/",
      "name": "The Global Desk",
      "publisher": {
        "@id": "https://thegdesk.com/#organization"
      },
      "inLanguage": "en"
    }
  ]
}
</script>
</head>

<body>

<header class="site-header" id="siteHeader">
    <div class="utility-bar">
        <div class="utility-inner">
            <div class="utility-left">
                <span id="liveDate">MONDAY, 17 AUGUST 2026</span>
                <span class="util-divider">|</span>
                <span id="liveTime">00:00:00 UTC</span>
                <span class="live-dot"></span>
            </div>
            <div class="utility-right">
                <a href="https://facebook.com/thegdesk" target="_blank"><i class="fa-brands fa-facebook-f"></i></a>
                <a href="https://x.com/thegdeskHQ" target="_blank"><svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
                <a href="https://youtube.com/@thegdesk" target="_blank"><i class="fa-brands fa-youtube"></i></a>
                <a href="https://instagram.com/thegdesk" target="_blank"><i class="fa-brands fa-instagram"></i></a>
                <a href="https://tiktok.com/@thegdesk" target="_blank"><i class="fa-brands fa-tiktok"></i></a>
            </div>
        </div>
    </div>

    <div class="header-main">
        <div class="header-inner">
            <a href="/" class="brand"><img src="/Logo.png" alt="The Global Desk"></a>
            <div class="header-actions">
                <a href="/search/" class="header-btn"><span>&#x2315;</span> Search</a>
                <button class="header-btn theme-btn" id="themeToggle">&#x25D0;</button>
            </div>
        </div>
    </div>

    <nav class="main-nav">
        <div class="nav-inner">
            <a href="/" class="nav-link active">Home</a>
            <a href="/category/world/" class="nav-link">World</a>
            <a href="/category/asia/" class="nav-link">Asia</a>
            <a href="/category/explainer/" class="nav-link">Explainer</a>
            <a href="/category/politics/" class="nav-link">Politics</a>

            <div class="dropdown" id="dropdown">
                <button class="nav-link dropdown-btn" id="dropdownBtn">More <span class="chevron">&#x25BE;</span></button>
                <div class="dropdown-content">
                    <a href="/category/economy/">Economy</a>
                    <a href="/category/tech-and-ai/">Tech and AI</a>
                    <a href="/category/science/">Science</a>
                    <a href="/category/environment/">Environment</a>
                    <a href="/category/research/">Research</a>
                    <a href="/category/human-rights/">Human Rights</a>
                    <a href="/z-desk/" class="highlight-link">Z Desk</a>
                    <a href="/alpha-desk/" class="highlight-link">Alpha Desk</a>
                </div>
            </div>
        </div>
    </nav>
    {% include "breaking.njk" %}
</header>

<section class="breaking-bar" id="breakingBar">
    <div class="breaking-inner">
        <div class="breaking-label"><span class="breaking-pulse"></span><strong>BREAKING</strong></div>
        <div class="breaking-track" id="breakingTrack"><div class="breaking-content" id="breakingNews"><a href="/" id="breakingLink">The Global Desk &mdash; Live</a></div></div>
        <button class="breaking-next" id="breakingNext">&#x203A;</button>
    </div>
</section>

<main class="main-container">

    <div class="home-top-bar">
        <div>
            <span class="section-kicker">LATEST</span>
            <h1 class="home-title">Top News</h1>
        </div>
        <span class="updated">Updated just now</span>
    </div>

    {% set allNews = collections.news | reverse %}

    {% if allNews.length %}
    <div class="home-grid">

        <aside class="home-left">
            <div class="side-heading">
                <span class="section-kicker">ALSO IN THE NEWS</span>
                <h3>More Headlines</h3>
            </div>
            <div class="side-news-list">
                {% for story in allNews %}
                    {% if loop.index > 1 and loop.index <= 5 %}
                    <article class="side-news-card">
                        <a href="{{ story.url }}" class="side-news-link">
                            {% if story.data.image %}
                            <div class="side-news-img-wrap">
                                <img src="{% if story.data.image[0] !== '/' and story.data.image.slice(0, 4) !== 'http' %}/{{ story.data.image }}{% else %}{{ story.data.image }}{% endif %}" alt="{{ story.data.title }}" class="side-news-img" loading="lazy">
                            </div>
                            {% endif %}
                            <span class="category-label">{{ story.data.category }}</span>
                            <h4>{{ story.data.title }}</h4>
                            <div class="side-news-meta">
                                <span class="time-ago" data-published="{{ story.data.date | isoDate }}">{{ story.data.date | readableDate }}</span>
                            </div>
                        </a>
                    </article>
                    {% endif %}
                {% endfor %}
            </div>
        </aside>

        <section class="home-center">
            {% set featured = allNews[0] %}
            <article class="hero-news-card">
                <a href="{{ featured.url }}" class="hero-news-link">
                    {% if featured.data.image %}
                    <div class="hero-news-image-wrap">
                        <img src="{% if featured.data.image[0] !== '/' and featured.data.image.slice(0, 4) !== 'http' %}/{{ featured.data.image }}{% else %}{{ featured.data.image }}{% endif %}" alt="{{ featured.data.title }}" class="hero-news-image">
                    </div>
                    {% endif %}
                    <div class="hero-news-content">
                        <span class="category-label">{{ featured.data.category | upper }}</span>
                        <h2 class="hero-news-title">{{ featured.data.title }}</h2>
                        <p class="hero-news-desc">{{ featured.data.description }}</p>
                        <div class="hero-news-meta">
                            <i class="fa-regular fa-user"></i> By <strong>The Global Desk</strong>
                            <span class="meta-divider">|</span>
                            <span class="time-ago" data-published="{{ featured.data.date | isoDate }}">{{ featured.data.date | readableDate }}</span>
                            {% if featured.data.source %}<span class="meta-divider">|</span> {{ featured.data.source }}{% endif %}
                        </div>
                    </div>
                </a>
            </article>

            {% if allNews.length > 5 %}
            {% set secondary = allNews[5] %}
            <article class="secondary-news-card">
                <a href="{{ secondary.url }}" class="secondary-news-link">
                    {% if secondary.data.image %}
                    <div class="secondary-news-img-wrap">
                        <img src="{% if secondary.data.image[0] !== '/' and secondary.data.image.slice(0, 4) !== 'http' %}/{{ secondary.data.image }}{% else %}{{ secondary.data.image }}{% endif %}" alt="{{ secondary.data.title }}" class="secondary-news-img" loading="lazy">
                    </div>
                    {% endif %}
                    <div class="secondary-news-content">
                        <span class="category-label">{{ secondary.data.category }}</span>
                        <h3>{{ secondary.data.title }}</h3>
                        <p>{{ secondary.data.description }}</p>
                    </div>
                </a>
            </article>
            {% endif %}
        </section>

        <aside class="home-right">
            <div class="sidebar-widget">
                <div class="widget-heading">
                    <i class="fa-solid fa-fire"></i>
                    <h4>Trending Now</h4>
                </div>
                <ol class="trending-list">
                    {% for story in allNews %}
                        {% if loop.index <= 5 %}
                        <li>
                            <a href="{{ story.url }}">
                                <span class="trending-rank">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span>
                                <span class="trending-title">{{ story.data.title }}</span>
                            </a>
                        </li>
                        {% endif %}
                    {% endfor %}
                </ol>
            </div>

            <div class="sidebar-widget">
                <div class="widget-heading">
                    <i class="fa-solid fa-layer-group"></i>
                    <h4>Explore</h4>
                </div>
                <div class="categories-list">
                    <a href="/category/world/">World</a>
                    <a href="/category/asia/">Asia</a>
                    <a href="/category/explainer/">Explainer</a>
                    <a href="/category/politics/">Politics</a>
                    <a href="/category/economy/">Economy</a>
                    <a href="/category/tech-and-ai/">Tech and AI</a>
                    <a href="/category/science/">Science</a>
                    <a href="/category/environment/">Environment</a>
                </div>
            </div>

            <!-- WORKING NEWSLETTER FORM -->
            <div class="sidebar-widget newsletter-widget">
                <h4>The Morning Brief</h4>
                <p>Get the top global stories in your inbox every morning.</p>
                <form
                    action="https://buttondown.com/api/emails/embed-subscribe/theglobaldesk"
                    method="post"
                    class="newsletter-form"
                    target="popupwindow"
                    onsubmit="window.open('https://buttondown.com/theglobaldesk', 'popupwindow', 'width=500,height=600,scrollbars=yes');">
                    <input
                        type="email"
                        name="email"
                        placeholder="Your email address"
                        required
                        autocomplete="email"
                        aria-label="Email address">
                    <button type="submit">Subscribe</button>
                </form>
                <small>No spam. Unsubscribe anytime.</small>
            </div>
        </aside>

    </div>
    {% else %}
    <p class="no-news">No news published yet.</p>
    {% endif %}

</main>

<footer class="site-footer">
    <div class="footer-main">
        <div class="footer-brand"><img src="/Logo.png" alt="The Global Desk"><p>International news, analysis and global affairs.</p></div>
        <div class="footer-column"><h4>Explore</h4><a href="/category/world/">World</a><a href="/category/asia/">Asia</a><a href="/category/economy/">Economy</a><a href="/category/science/">Science</a></div>
        <div class="footer-column"><h4>Information</h4><a href="/about/">About Us</a><a href="/editorial-policy/">Editorial Policy</a><a href="/contact/">Contact</a><a href="/privacy/">Privacy Policy</a></div>
        <div class="footer-column"><h4>Follow</h4><a href="https://facebook.com/thegdesk" target="_blank"><i class="fa-brands fa-facebook-f"></i> Facebook</a><a href="https://x.com/thegdeskHQ" target="_blank"><i class="fa-brands fa-x-twitter"></i> X</a><a href="https://youtube.com/@thegdesk" target="_blank"><i class="fa-brands fa-youtube"></i> YouTube</a><a href="https://instagram.com/thegdesk" target="_blank"><i class="fa-brands fa-instagram"></i> Instagram</a><a href="https://tiktok.com/@thegdesk" target="_blank"><i class="fa-brands fa-tiktok"></i> TikTok</a></div>
    </div>
    <div class="footer-bottom"><span>&copy; 2026 The Global Desk. All Rights Reserved.</span><span>Independent International News Platform</span></div>
</footer>

<div class="toast" id="toast"><span>&#x2713;</span><p id="toastMessage">Done</p></div>
<script src="/app.js"></script>
</body>
</html>
