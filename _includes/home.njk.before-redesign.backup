<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <title>The Global Desk | World News, Research &amp; Global Analysis</title>
    <meta name="description" content="The Global Desk is an independent digital news platform headquartered in Dhaka, Bangladesh, covering South Asia, Asia and global affairs through news, research, in-depth analysis and education.">
    <meta name="author" content="The Global Desk">
    <meta name="robots" content="index, follow">
    <meta name="theme-color" content="#071a33">
    <link rel="canonical" href="https://thegdesk.com/">

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-X1E8X103FR"></script>
    <script>window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', 'G-X1E8X103FR');</script>

    <meta property="og:type" content="website">
    <meta property="og:url" content="https://thegdesk.com/">
    <meta property="og:title" content="The Global Desk | World News, Research &amp; Global Analysis">
    <meta property="og:description" content="Independent news, research and global analysis from Dhaka, Bangladesh, covering South Asia, Asia and the world.">
    <meta property="og:image" content="https://thegdesk.com/Logo.png">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="The Global Desk | World News, Research &amp; Global Analysis">
    <meta name="twitter:description" content="Independent news, research and global analysis from Dhaka, Bangladesh, covering South Asia, Asia and the world.">
    <meta name="twitter:image" content="https://thegdesk.com/Logo.png">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "NewsMediaOrganization",
          "@id": "https://thegdesk.com/#organization",
          "name": "The Global Desk",
          "url": "https://thegdesk.com/",
          "logo": {"@type": "ImageObject", "url": "https://thegdesk.com/Logo.png"},
          "foundingDate": "2026",
          "email": "contact@thegdesk.com",
          "address": {"@type": "PostalAddress", "addressLocality": "Dhaka", "addressCountry": "BD"},
          "areaServed": ["South Asia", "Asia", "Worldwide"],
          "sameAs": [
            "https://facebook.com/thegdesk",
            "https://youtube.com/@thegdesk",
            "https://x.com/thegdeskHQ",
            "https://instagram.com/thegdesk",
            "https://tiktok.com/@thegdesk"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://thegdesk.com/#website",
          "url": "https://thegdesk.com/",
          "name": "The Global Desk",
          "publisher": {"@id": "https://thegdesk.com/#organization"},
          "inLanguage": "en"
        }
      ]
    }
    </script>
</head>
<body>
{% set allNews = collections.news | reverse %}
{% macro imageUrl(image) %}{% if image[0] !== '/' and image.slice(0, 4) !== 'http' %}/{{ image }}{% else %}{{ image }}{% endif %}{% endmacro %}

<header class="site-header" id="siteHeader">
    <div class="utility-bar">
        <div class="utility-inner">
            <div class="utility-left">
                <span id="liveDate">THE GLOBAL DESK</span>
                <span class="util-divider">|</span>
                <span id="liveTime">UTC</span>
                <span class="live-dot" aria-hidden="true"></span>
            </div>
            <div class="utility-right" aria-label="Social media">
                <a href="https://facebook.com/thegdesk" target="_blank" rel="noopener" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                <a href="https://x.com/thegdeskHQ" target="_blank" rel="noopener" aria-label="X"><i class="fa-brands fa-x-twitter"></i></a>
                <a href="https://youtube.com/@thegdesk" target="_blank" rel="noopener" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a>
                <a href="https://instagram.com/thegdesk" target="_blank" rel="noopener" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                <a href="https://tiktok.com/@thegdesk" target="_blank" rel="noopener" aria-label="TikTok"><i class="fa-brands fa-tiktok"></i></a>
            </div>
        </div>
    </div>

    <div class="header-main">
        <div class="header-inner">
            <a href="/" class="brand" aria-label="The Global Desk homepage"><img src="/Logo.png" alt="The Global Desk"></a>
            <div class="header-actions">
                <a href="/search/" class="header-btn"><span aria-hidden="true">&#x2315;</span> Search</a>
                <button class="header-btn theme-btn" id="themeToggle" type="button" aria-label="Toggle dark mode">&#x25D0;</button>
            </div>
        </div>
    </div>

    <nav class="main-nav" aria-label="Main navigation">
        <div class="nav-inner">
            <a href="/" class="nav-link active">Home</a>
            <a href="/category/world/" class="nav-link">World</a>
            <a href="/category/asia/" class="nav-link">Asia</a>
            <a href="/category/politics/" class="nav-link">Politics</a>
            <a href="/category/economy/" class="nav-link">Business</a>
            <a href="/category/science/" class="nav-link">Science</a>
            <div class="dropdown" id="dropdown">
                <button class="nav-link dropdown-btn" id="dropdownBtn" type="button" aria-expanded="false">More <span class="chevron">&#x25BE;</span></button>
                <div class="dropdown-content">
                    <a href="/category/explainer/">Explainers &amp; Analysis</a>
                    <a href="/category/tech-and-ai/">Technology &amp; AI</a>
                    <a href="/category/environment/">Environment</a>
                    <a href="/category/research/">Research &amp; Studies</a>
                    <a href="/category/human-rights/">Human Rights</a>
                    <a href="/alpha-desk/">Alpha Desk</a>
                </div>
            </div>
        </div>
    </nav>
</header>

<section class="breaking-bar" id="breakingBar" aria-label="Breaking news">
    <div class="breaking-inner">
        <div class="breaking-label"><span class="breaking-pulse" aria-hidden="true"></span><strong>BREAKING</strong></div>
        <div class="breaking-track" id="breakingTrack">
            <div class="breaking-content" id="breakingNews"><a href="/" id="breakingLink">The Global Desk — Live</a></div>
        </div>
        <button class="breaking-next" id="breakingNext" type="button" aria-label="Next breaking headline">&#x203A;</button>
    </div>
</section>

<main class="tdg-home">
    <div class="tdg-edition-line">
        <span><i class="fa-solid fa-globe"></i> INDEPENDENT GLOBAL NEWSROOM</span>
        <span class="tdg-edition-date">NEWS · ANALYSIS · RESEARCH</span>
    </div>

    {% if allNews.length %}
    <section class="tdg-lead-grid" aria-label="Top stories">
        <div class="tdg-lead-main">
            {% set lead = allNews[0] %}
            <article class="tdg-lead-story">
                <a href="{{ lead.url }}" class="tdg-image-link">
                    {% if lead.data.image %}
                    <img src="{{ imageUrl(lead.data.image) }}" alt="{{ lead.data.title }}" class="tdg-lead-image" fetchpriority="high">
                    {% else %}
                    <div class="tdg-image-placeholder"><i class="fa-regular fa-newspaper"></i></div>
                    {% endif %}
                </a>
                <div class="tdg-lead-copy">
                    <span class="tdg-category">{{ lead.data.category | upper }}</span>
                    <h1><a href="{{ lead.url }}">{{ lead.data.title }}</a></h1>
                    {% if lead.data.description %}<p>{{ lead.data.description }}</p>{% endif %}
                    <div class="tdg-meta">THE GLOBAL DESK <span>·</span> <time class="time-ago" data-published="{{ lead.data.date | isoDate }}">{{ lead.data.date | readableDate }}</time>{% if lead.data.source %}<span>·</span> {{ lead.data.source }}{% endif %}</div>
                </div>
            </article>
        </div>

        <aside class="tdg-lead-side">
            <div class="tdg-block-heading"><span>TOP STORIES</span><a href="/search/">All news <i class="fa-solid fa-arrow-right"></i></a></div>
            {% for story in allNews %}
                {% if loop.index > 1 and loop.index <= 6 %}
                <article class="tdg-top-item">
                    <span class="tdg-category">{{ story.data.category }}</span>
                    <h2><a href="{{ story.url }}">{{ story.data.title }}</a></h2>
                    <time class="time-ago" data-published="{{ story.data.date | isoDate }}">{{ story.data.date | readableDate }}</time>
                </article>
                {% endif %}
            {% endfor %}
        </aside>
    </section>

    <section class="tdg-latest-section">
        <div class="tdg-section-heading">
            <div><span class="tdg-overline">THE NEWSROOM</span><h2>Latest News</h2></div>
            <a href="/search/" class="tdg-view-all">View all <i class="fa-solid fa-arrow-right"></i></a>
        </div>
        <div class="tdg-latest-grid">
            {% for story in allNews %}
                {% if loop.index > 1 and loop.index <= 9 %}
                <article class="tdg-news-card">
                    <a href="{{ story.url }}" class="tdg-card-image">
                        {% if story.data.image %}
                        <img src="{{ imageUrl(story.data.image) }}" alt="{{ story.data.title }}" loading="lazy">
                        {% else %}
                        <span class="tdg-image-placeholder"><i class="fa-regular fa-newspaper"></i></span>
                        {% endif %}
                    </a>
                    <div class="tdg-card-copy">
                        <span class="tdg-category">{{ story.data.category }}</span>
                        <h3><a href="{{ story.url }}">{{ story.data.title }}</a></h3>
                        {% if story.data.description %}<p>{{ story.data.description }}</p>{% endif %}
                        <time class="time-ago" data-published="{{ story.data.date | isoDate }}">{{ story.data.date | readableDate }}</time>
                    </div>
                </article>
                {% endif %}
            {% endfor %}
        </div>
    </section>

    <section class="tdg-topic-band">
        <div class="tdg-section-heading">
            <div><span class="tdg-overline">FOLLOW THE STORY</span><h2>Explore the World</h2></div>
        </div>
        <div class="tdg-topic-grid">
            <a href="/category/world/" class="tdg-topic-card"><span class="tdg-topic-icon"><i class="fa-solid fa-earth-americas"></i></span><strong>World</strong><small>Global affairs · Diplomacy · Conflict</small><i class="fa-solid fa-arrow-right"></i></a>
            <a href="/category/asia/" class="tdg-topic-card"><span class="tdg-topic-icon"><i class="fa-solid fa-earth-asia"></i></span><strong>Asia</strong><small>South Asia · East Asia · Southeast Asia</small><i class="fa-solid fa-arrow-right"></i></a>
            <a href="/category/politics/" class="tdg-topic-card"><span class="tdg-topic-icon"><i class="fa-solid fa-landmark"></i></span><strong>Politics</strong><small>Elections · Policy · Geopolitics</small><i class="fa-solid fa-arrow-right"></i></a>
            <a href="/category/economy/" class="tdg-topic-card"><span class="tdg-topic-icon"><i class="fa-solid fa-chart-line"></i></span><strong>Business</strong><small>Economy · Finance · Trade</small><i class="fa-solid fa-arrow-right"></i></a>
            <a href="/category/science/" class="tdg-topic-card"><span class="tdg-topic-icon"><i class="fa-solid fa-flask"></i></span><strong>Science</strong><small>Discovery · Space · Innovation</small><i class="fa-solid fa-arrow-right"></i></a>
            <a href="/category/research/" class="tdg-topic-card"><span class="tdg-topic-icon"><i class="fa-solid fa-book-open"></i></span><strong>Research</strong><small>Research papers · Academic studies · Evidence</small><i class="fa-solid fa-arrow-right"></i></a>
        </div>
    </section>

    <section class="tdg-editorial-grid">
        <div class="tdg-editorial-main">
            <div class="tdg-section-heading">
                <div><span class="tdg-overline">BEYOND THE HEADLINES</span><h2>Research &amp; In-Depth</h2></div>
                <a href="/category/research/" class="tdg-view-all">Explore research <i class="fa-solid fa-arrow-right"></i></a>
            </div>
            <div class="tdg-research-list">
                {% for story in allNews %}
                    {% if story.data.category == "Research" or story.data.category == "Explainer" %}
                    <article class="tdg-research-item">
                        {% if story.data.image %}<a href="{{ story.url }}" class="tdg-research-thumb"><img src="{{ imageUrl(story.data.image) }}" alt="{{ story.data.title }}" loading="lazy"></a>{% endif %}
                        <div><span class="tdg-category">{{ story.data.category }}</span><h3><a href="{{ story.url }}">{{ story.data.title }}</a></h3>{% if story.data.description %}<p>{{ story.data.description }}</p>{% endif %}<time class="time-ago" data-published="{{ story.data.date | isoDate }}">{{ story.data.date | readableDate }}</time></div>
                    </article>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
        <aside class="tdg-briefing">
            <span class="tdg-overline">THE GLOBAL DESK</span>
            <h2>The Morning Brief</h2>
            <p>A concise selection of global headlines and important developments, delivered to your inbox.</p>
            <form action="https://buttondown.com/api/emails/embed-subscribe/theglobaldesk" method="post" class="newsletter-form" target="popupwindow" onsubmit="window.open('https://buttondown.com/theglobaldesk', 'popupwindow', 'width=500,height=600,scrollbars=yes');">
                <input type="email" name="email" placeholder="Your email address" required autocomplete="email" aria-label="Email address">
                <button type="submit">Subscribe</button>
            </form>
            <small>No spam. Unsubscribe anytime.</small>
        </aside>
    </section>

    <section class="tdg-category-strip">
        <div class="tdg-section-heading"><div><span class="tdg-overline">MORE PERSPECTIVES</span><h2>Across Every Desk</h2></div></div>
        <div class="tdg-category-links">
            <a href="/category/tech-and-ai/"><i class="fa-solid fa-microchip"></i><span><b>Technology</b><small>AI · Cybersecurity · Digital world</small></span></a>
            <a href="/category/environment/"><i class="fa-solid fa-leaf"></i><span><b>Environment</b><small>Climate · Nature · Sustainability</small></span></a>
            <a href="/category/human-rights/"><i class="fa-solid fa-scale-balanced"></i><span><b>Human Rights</b><small>Rights · Justice · Society</small></span></a>
            <a href="/category/explainer/"><i class="fa-solid fa-lightbulb"></i><span><b>Explainers</b><small>Context · Analysis · Background</small></span></a>
        </div>
    </section>
    {% else %}
    <section class="tdg-empty-state"><i class="fa-regular fa-newspaper"></i><h1>Newsroom is getting ready</h1><p>New stories will appear here as soon as they are published.</p></section>
    {% endif %}
</main>

<footer class="site-footer">
    <div class="footer-main">
        <div class="footer-brand"><img src="/Logo.png" alt="The Global Desk"><p>Independent journalism, global perspectives and evidence-led research.</p></div>
        <div class="footer-column"><h4>Explore</h4><a href="/category/world/">World</a><a href="/category/asia/">Asia</a><a href="/category/politics/">Politics</a><a href="/category/economy/">Business</a><a href="/category/research/">Research</a></div>
        <div class="footer-column"><h4>Information</h4><a href="/about/">About Us</a><a href="/editorial-policy/">Editorial Policy</a><a href="/contact/">Contact</a><a href="/privacy/">Privacy Policy</a></div>
        <div class="footer-column"><h4>Follow</h4><a href="https://facebook.com/thegdesk" target="_blank" rel="noopener"><i class="fa-brands fa-facebook-f"></i> Facebook</a><a href="https://x.com/thegdeskHQ" target="_blank" rel="noopener"><i class="fa-brands fa-x-twitter"></i> X</a><a href="https://youtube.com/@thegdesk" target="_blank" rel="noopener"><i class="fa-brands fa-youtube"></i> YouTube</a><a href="https://instagram.com/thegdesk" target="_blank" rel="noopener"><i class="fa-brands fa-instagram"></i> Instagram</a><a href="https://tiktok.com/@thegdesk" target="_blank" rel="noopener"><i class="fa-brands fa-tiktok"></i> TikTok</a></div>
    </div>
    <div class="footer-bottom"><span>&copy; 2026 The Global Desk. All Rights Reserved.</span><span>Independent International News Platform</span></div>
</footer>

<div class="toast" id="toast"><span>&#x2713;</span><p id="toastMessage">Done</p></div>
<script src="/app.js"></script>
</body>
</html>
