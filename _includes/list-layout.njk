<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <title>{{ pageTitle }} | The Global Desk</title>
    <link rel="canonical" href="https://thegdesk.com{{ page.url }}">

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-X1E8X103FR"></script>
    <script>window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', 'G-X1E8X103FR');</script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/homepage.css?v=20261128-publish-time-profile-byline-v3">
</head>

<body>

{% include 'global-header.njk' %}


<main class="main-container">
    <section class="latest-section">
        <div class="section-heading">
            <div><span class="section-kicker">EXPLORE</span><h1>{{ pageTitle }}</h1></div>
            <a href="/" class="view-all" style="text-decoration: none; font-size: 12px; font-weight: 700; color: var(--blue);">← Back to Home</a>
        </div>

        <div class="news-list">
            {% set count = 0 %}
            {% for story in collections.news %}
                {% if not activeCategory or story.data.category == activeCategory %}
                    {% set count = count + 1 %}
                    <article class="news-card {% if count == 1 %}news-card-featured{% else %}news-card-small{% endif %}">
                        <a href="{{ story.url }}" class="news-card-link">
                            {% if story.data.image %}
                            <img src="{% if story.data.image[0] !== '/' and story.data.image.slice(0, 4) !== 'http' %}/{{ story.data.image }}{% else %}{{ story.data.image }}{% endif %}" alt="{{ story.data.title }}" class="news-image" loading="lazy">
                            {% else %}
                            <div class="news-image news-image-placeholder"></div>
                            {% endif %}
                            <div class="news-info">
                                <span class="category-label">{{ story.data.category }}</span>
                                <h3>{{ story.data.title }}</h3>
                                <p>{{ story.data.description }}</p>
                                <div class="news-meta">
                                    <time class="time-ago" datetime="{{ (story.data.publishedAt or story.date) | isoDate }}" data-relative-time data-date-only="{% if not story.data.publishedAt %}true{% else %}false{% endif %}">{{ (story.data.publishedAt or story.date) | relativeDate }}</time>
                                    — {{ story.data.source or "The Global Desk" }}
                                </div>
                            </div>
                        </a>
                    </article>
                {% endif %}
            {% endfor %}

            {% if count == 0 %}
                <p class="no-news">No news found in this category yet.</p>
            {% endif %}
        </div>
    </section>
</main>

{% include 'global-footer.njk' %}

<div class="toast" id="toast"><span>✓</span><p id="toastMessage">Done</p></div>
<script>
(function () {
  const times = document.querySelectorAll('[data-relative-time][datetime]');
  const absoluteDate = new Intl.DateTimeFormat('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
  function refresh() {
    const now = Date.now();
    times.forEach(function (time) {
      const publishedDate = new Date(time.dateTime);
      const published = publishedDate.getTime();
      if (!Number.isFinite(published)) return;
      if (time.dataset.dateOnly === 'true' || published > now) { time.textContent = absoluteDate.format(publishedDate); return; }
      const minutes = Math.floor((now - published) / 60000);
      if (minutes < 1) time.textContent = 'Just now';
      else if (minutes < 60) time.textContent = minutes + (minutes === 1 ? ' minute ago' : ' minutes ago');
      else {
        const hours = Math.floor(minutes / 60);
        if (hours < 24) time.textContent = hours + (hours === 1 ? ' hour ago' : ' hours ago');
        else {
          const days = Math.floor(hours / 24);
          time.textContent = days < 7 ? days + (days === 1 ? ' day ago' : ' days ago') : absoluteDate.format(publishedDate);
        }
      }
    });
  }
  refresh();
  window.setInterval(refresh, 60000);
})();
</script>
<script src="/app.js"></script>
</body>
</html>
