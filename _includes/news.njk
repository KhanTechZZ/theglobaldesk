<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <title>{{ title }} - The Global Desk</title>
    <meta name="description" content="{{ description or 'Read the latest international news on The Global Desk.' }}">
    <meta name="author" content="{{ source or 'The Global Desk' }}">
    <meta name="robots" content="index, follow, max-image-preview:large">
    <link rel="canonical" href="https://thegdesk.com{{ page.url }}">

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-X1E8X103FR"></script>
    <script>window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', 'G-X1E8X103FR');</script>

    <meta property="og:type" content="article">
    <meta property="og:site_name" content="The Global Desk">
    <meta property="og:url" content="https://thegdesk.com{{ page.url }}">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ description or 'Read the latest international news on The Global Desk.' }}">
    {% if image %}<meta property="og:image" content="{% if image[0] !== '/' and image.slice(0, 4) !== 'http' %}https://thegdesk.com/{{ image }}{% elif image.slice(0, 4) === 'http' %}{{ image }}{% else %}https://thegdesk.com{{ image }}{% endif %}">{% else %}<meta property="og:image" content="https://thegdesk.com/Logo.png">{% endif %}
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:title" content="{{ title }}">
    <meta property="twitter:description" content="{{ description or 'Read the latest international news on The Global Desk.' }}">
    {% if image %}<meta property="twitter:image" content="{% if image[0] !== '/' and image.slice(0, 4) !== 'http' %}https://thegdesk.com/{{ image }}{% elif image.slice(0, 4) === 'http' %}{{ image }}{% else %}https://thegdesk.com{{ image }}{% endif %}">{% else %}<meta property="twitter:image" content="https://thegdesk.com/Logo.png">{% endif %}

    <script type="application/ld+json">
    { "@context": "https://schema.org", "@type": "NewsArticle", "headline": {{ title | jsonify | safe }}, "image": [{% if image %}"{% if image[0] !== '/' and image.slice(0, 4) !== 'http' %}https://thegdesk.com/{{ image }}{% elif image.slice(0, 4) === 'http' %}{{ image }}{% else %}https://thegdesk.com{{ image }}{% endif %}"{% else %}"https://thegdesk.com/Logo.png"{% endif %}], "datePublished": {{ date | isoDate | jsonify | safe }}, "dateModified": {{ date | isoDate | jsonify | safe }}, "author": { "@type": "Organization", "name": "The Global Desk", "url": "https://thegdesk.com/" }, "publisher": { "@type": "Organization", "@id": "https://thegdesk.com/#organization", "name": "The Global Desk", "url": "https://thegdesk.com/", "logo": { "@type": "ImageObject", "url": "https://thegdesk.com/Logo.png" } }, "description": {{ (description or 'Read the latest international news on The Global Desk.') | jsonify | safe }} }
    </script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/homepage.css?v=20261126-section-category-scale">
</head>
<body>


{% include 'global-header.njk' %}


<main class="main-container">
    <article class="article-page" data-article-slug="{{ page.fileSlug }}">
        <div class="breadcrumbs"><a href="/">Home</a> <span>/</span> <a href="/category/{{ category | slug }}/">{{ category }}</a> <span>/</span> <span>Article</span></div>
        {% if category %}<span class="category-label">{{ category | upper }}</span>{% endif %}
        <h1 class="article-title">{{ title }}</h1>
        <div class="article-meta">
            <span class="author-byline"><i class="fa-regular fa-user"></i> By <strong>The Global Desk</strong></span>
            <span class="meta-divider">|</span>
            <span class="time-ago" data-published="{{ date | isoDate }}">{{ date | readableDate }}</span>
            <span class="meta-divider">|</span>
            <span id="readingTime">2 min read</span>
        </div>

        <div class="share-buttons">
            <span class="share-label">Share:</span>
            <a href="#" id="shareX" class="share-btn"><svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
            <a href="#" id="shareFB" class="share-btn"><i class="fa-brands fa-facebook-f"></i></a>
            <a href="#" id="shareWA" class="share-btn"><i class="fa-brands fa-whatsapp"></i></a>
            <button id="shareCopy" class="share-btn copy-btn"><i class="fa-solid fa-link"></i></button>
        </div>

        {% if image %}
        <img src="{% if image[0] !== '/' and image.slice(0, 4) !== 'http' %}/{{ image }}{% else %}{{ image }}{% endif %}" alt="{{ title }}" class="article-image">
        {% endif %}

        <div class="article-body">{{ content | safe }}</div>
        <div class="article-footer"><a href="/" class="read-link">← Back to Homepage</a></div>
    </article>

    <section class="related-news">
        <h2 class="related-title">More from {{ category }}</h2>
        <div class="related-grid">
            {% set count = 0 %}
            {% for item in collections.news | reverse %}
                {% if item.data.category == category and item.url != page.url and count < 3 %}
                    {% set count = count + 1 %}
                    <article class="related-card">
                        <a href="{{ item.url }}">
                            {% if item.data.image %}<img src="{% if item.data.image[0] !== '/' and item.data.image.slice(0, 4) !== 'http' %}/{{ item.data.image }}{% else %}{{ item.data.image }}{% endif %}" loading="lazy" alt="{{ item.data.title }}">{% endif %}
                            <h3>{{ item.data.title }}</h3>
                        </a>
                    </article>
                {% endif %}
            {% endfor %}
        </div>
    </section>
</main>

{% include 'global-footer.njk' %}

<div class="toast" id="toast"><span>✓</span><p id="toastMessage">Done</p></div>
<script src="/app.js"></script>

<script>
(function () {
  var slug = window.location.pathname.split('/').filter(Boolean).pop() || 'home';

  if (slug === 'admin' || slug === 'api') return;

  fetch('/api/views', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ slug: slug })
  }).catch(function (err) {
    console.error('View counter error:', err);
  });
})();
</script>
</body>
</html>
