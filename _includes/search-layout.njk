<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <title>Search | The Global Desk</title>
    <meta name="robots" content="noindex, follow">
    <link rel="canonical" href="https://thegdesk.com/search/">

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-X1E8X103FR"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-X1E8X103FR');
    </script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/homepage.css?v=20261126-shared-chrome">
</head>

<body>

{% include 'global-header.njk' %}


<main class="main-container">
    <section class="search-section">
        <div class="section-heading">
            <div>
                <span class="section-kicker">SEARCH</span>
                <h1>Find a Story</h1>
            </div>
        </div>

        <div class="search-box-wrap">
            <input type="text" id="searchInput" class="search-input" placeholder="Search stories, countries, topics..." autocomplete="off">
            <button class="search-clear" id="searchClear" aria-label="Clear">×</button>
        </div>

        <div id="searchStats" class="search-stats"></div>
        <div id="searchResults" class="news-list"></div>
    </section>
</main>

{% include 'global-footer.njk' %}

<div class="toast" id="toast"><span>✓</span><p id="toastMessage">Done</p></div>

<script src="/app.js"></script>
</body>
</html>
