<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <title>Search | The Global Desk</title>
    <meta name="robots" content="noindex, follow">
    <link rel="canonical" href="https://thegdesk.com/search/">

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-X1E8X103FR"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-X1E8X103FR');
    </script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/homepage.css?v=20261128-publish-time-profile-byline-v3">
</head>

<body>

{% include 'global-header.njk' %}


<main class="main-container">
    <section class="search-section">
        <div class="section-heading">
            <div>
                <span class="section-kicker">SEARCH</span>
                <h1>Find a Story</h1>
            </div>
        </div>

        <form class="search-box-wrap" id="storySearchForm" action="/search/" method="get" role="search">
            <input type="search" id="searchInput" name="q" class="search-input" placeholder="Search stories, countries, topics..." autocomplete="off" aria-label="Search stories, countries and topics">
            <button class="search-clear" id="searchClear" type="button" aria-label="Clear search" hidden>×</button>
            <button class="story-search-submit" type="submit">Search</button>
        </form>

        <div id="searchStats" class="search-stats"></div>
        <div id="searchResults" class="news-list"></div>
    </section>
</main>

{% include 'global-footer.njk' %}

<div class="toast" id="toast"><span>✓</span><p id="toastMessage">Done</p></div>

<script type="application/json" id="storySearchIndex">[{% for post in collections.publishedNews %}{% if not loop.first %},{% endif %}{"title":{{ post.data.title | jsonify | safe }},"description":{{ (post.data.description or post.data.excerpt or "") | jsonify | safe }},"category":{{ (post.data.category or "News") | jsonify | safe }},"url":{{ post.url | jsonify | safe }},"date":{{ (post.data.publishedAt or post.date) | isoDate | jsonify | safe }},"dateOnly":{{ (not post.data.publishedAt) | jsonify | safe }}}{% endfor %}]</script>
<script>
(function () {
  var form = document.getElementById('storySearchForm');
  var input = document.getElementById('searchInput');
  var clear = document.getElementById('searchClear');
  var stats = document.getElementById('searchStats');
  var results = document.getElementById('searchResults');
  var index = document.getElementById('storySearchIndex');
  if (!form || !input || !results || !index) return;

  var stories = [];
  try { stories = JSON.parse(index.textContent); } catch (error) { stories = []; }
  var params = new URLSearchParams(window.location.search);
  input.value = params.get('q') || '';
  var absoluteDate = new Intl.DateTimeFormat('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });

  function updateResultTimes() {
    results.querySelectorAll('[data-relative-time][datetime]').forEach(function (time) {
      var publishedDate = new Date(time.dateTime);
      var published = publishedDate.getTime();
      if (!Number.isFinite(published)) return;
      if (time.dataset.dateOnly === 'true' || published > Date.now()) { time.textContent = absoluteDate.format(publishedDate); return; }
      var minutes = Math.floor((Date.now() - published) / 60000);
      if (minutes < 1) { time.textContent = 'Just now'; return; }
      if (minutes < 60) { time.textContent = minutes + (minutes === 1 ? ' minute ago' : ' minutes ago'); return; }
      var hours = Math.floor(minutes / 60);
      if (hours < 24) { time.textContent = hours + (hours === 1 ? ' hour ago' : ' hours ago'); return; }
      var days = Math.floor(hours / 24);
      time.textContent = days < 7 ? days + (days === 1 ? ' day ago' : ' days ago') : absoluteDate.format(publishedDate);
    });
  }

  function addText(parent, tag, className, value) {
    var element = document.createElement(tag);
    if (className) element.className = className;
    element.textContent = value || '';
    parent.appendChild(element);
    return element;
  }

  function render() {
    var query = input.value.trim().toLocaleLowerCase();
    clear.hidden = !query;
    results.replaceChildren();
    if (!query) {
      stats.textContent = 'Search published stories by headline, topic or country.';
      return;
    }
    var terms = query.split(/\\s+/).filter(Boolean);
    var matches = stories.filter(function (story) {
      var text = [story.title, story.description, story.category].join(' ').toLocaleLowerCase();
      return terms.every(function (term) { return text.includes(term); });
    }).slice(0, 50);
    stats.textContent = matches.length ? matches.length + (matches.length === 1 ? ' story found' : ' stories found') : 'No stories found. Try another keyword.';
    matches.forEach(function (story) {
      var card = document.createElement('article');
      card.className = 'search-result-card';
      var category = addText(card, 'span', 'search-result-card__category', story.category);
      var link = document.createElement('a');
      link.href = story.url;
      link.className = 'search-result-card__title';
      link.textContent = story.title;
      card.appendChild(link);
      if (story.date) {
        var time = addText(card, 'time', 'search-result-card__date', '');
        time.dateTime = story.date;
        time.dataset.relativeTime = '';
        time.dataset.dateOnly = String(story.dateOnly === true);
      }
      if (story.description) addText(card, 'p', 'search-result-card__description', story.description);
      results.appendChild(card);
    });
    updateResultTimes();
  }

  form.addEventListener('submit', function (event) {
    event.preventDefault();
    var query = input.value.trim();
    window.history.replaceState({}, '', query ? '/search/?q=' + encodeURIComponent(query) : '/search/');
    render();
  });
  input.addEventListener('input', render);
  window.setInterval(updateResultTimes, 60000);
  clear.addEventListener('click', function () {
    input.value = '';
    window.history.replaceState({}, '', '/search/');
    render();
    input.focus();
  });
  render();
})();
</script>
</body>
</html>
