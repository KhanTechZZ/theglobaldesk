<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <title>{% if title == "About The Global Desk" %}{{ title }}{% else %}{{ title }} | The Global Desk{% endif %}</title>
    <meta name="description" content="{{ description or 'Explore The Global Desk for independent news, research and analysis covering South Asia, Asia and global affairs.' }}">
    <meta name="author" content="The Global Desk">
    <meta name="robots" content="index, follow, max-image-preview:large">
    <meta name="theme-color" content="#071a33">
    <link rel="canonical" href="https://thegdesk.com{{ page.url }}">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="The Global Desk">
    <meta property="og:title" content="{% if title == 'About The Global Desk' %}{{ title }}{% else %}{{ title }} | The Global Desk{% endif %}">
    <meta property="og:description" content="{{ description or 'Independent news, research and analysis from The Global Desk.' }}">
    <meta property="og:url" content="https://thegdesk.com{{ page.url }}">
    <meta property="og:image" content="https://thegdesk.com/Logo.png">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{% if title == 'About The Global Desk' %}{{ title }}{% else %}{{ title }} | The Global Desk{% endif %}">
    <meta name="twitter:description" content="{{ description or 'Independent news, research and analysis from The Global Desk.' }}">
    <meta name="twitter:image" content="https://thegdesk.com/Logo.png">

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "{% if page.fileSlug == 'about' %}AboutPage{% elif page.fileSlug == 'contact' %}ContactPage{% else %}WebPage{% endif %}",
      "dateModified": {{ lastModified | jsonify | safe }},
      "name": {{ title | jsonify | safe }},
      "description": {{ (description or 'Independent news, research and analysis from The Global Desk.') | jsonify | safe }},
      "url": "https://thegdesk.com{{ page.url }}",
      "isPartOf": {
        "@type": "WebSite",
        "name": "The Global Desk",
        "url": "https://thegdesk.com/"
      },
      "publisher": {
        "@type": "Organization",
        "name": "The Global Desk",
        "url": "https://thegdesk.com/",
        "contactPoint": { "@type": "ContactPoint", "email": "contact@thegdesk.com", "contactType": "editorial enquiries" }
      },
      "inLanguage": "en"
    }
    </script>
    <script type="application/ld+json">
    {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://thegdesk.com/"},{"@type":"ListItem","position":2,"name":{{ title | jsonify | safe }},"item":"https://thegdesk.com{{ page.url }}"}]}
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-X1E8X103FR"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-X1E8X103FR');
    </script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/homepage.css?v=20261127-globaldesk-topics-v6">
</head>
<body>


{% include 'global-header.njk' %}


<main class="gd-static-page gd-static-page--{{ page.fileSlug }}">
  <div class="gd-static-container">
    <nav class="gd-static-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">{{ title | replace("The Global Desk", "") | trim }}</span></nav>
    <header class="gd-static-header"><span class="gd-static-eyebrow">The Global Desk</span><h1>{{ title }}</h1><p>{{ description }}</p></header>
    <div class="gd-static-content">{{ content | safe }}</div>
    <nav class="gd-static-related-links" aria-label="More about The Global Desk"><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/editorial-policy/">Editorial Policy</a></nav>
    <a href="/" class="gd-static-back">← Back to homepage</a>
  </div>
</main>

{% include 'global-footer.njk' %}

<script src="/app.js"></script>
</body>
</html>
