<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <title>{% if title == "About The Global Desk" %}{{ title }}{% else %}{{ title }} | The Global Desk{% endif %}</title>
    <meta name="description" content="{{ description or 'Explore The Global Desk for independent news, research and analysis covering South Asia, Asia and global affairs.' }}">
    <meta name="author" content="The Global Desk">
    <meta name="robots" content="index, follow, max-image-preview:large">
    <meta name="theme-color" content="#071a33">
    <link rel="canonical" href="https://thegdesk.com{{ page.url }}">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="The Global Desk">
    <meta property="og:title" content="{% if title == 'About The Global Desk' %}{{ title }}{% else %}{{ title }} | The Global Desk{% endif %}">
    <meta property="og:description" content="{{ description or 'Independent news, research and analysis from The Global Desk.' }}">
    <meta property="og:url" content="https://thegdesk.com{{ page.url }}">
    <meta property="og:image" content="https://thegdesk.com/Logo.png">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{% if title == 'About The Global Desk' %}{{ title }}{% else %}{{ title }} | The Global Desk{% endif %}">
    <meta name="twitter:description" content="{{ description or 'Independent news, research and analysis from The Global Desk.' }}">
    <meta name="twitter:image" content="https://thegdesk.com/Logo.png">

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": {{ title | jsonify | safe }},
      "description": {{ (description or 'Independent news, research and analysis from The Global Desk.') | jsonify | safe }},
      "url": "https://thegdesk.com{{ page.url }}",
      "isPartOf": {
        "@type": "WebSite",
        "name": "The Global Desk",
        "url": "https://thegdesk.com/"
      },
      "publisher": {
        "@type": "Organization",
        "name": "The Global Desk",
        "url": "https://thegdesk.com/"
      },
      "inLanguage": "en"
    }
    </script>

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-X1E8X103FR"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-X1E8X103FR');
    </script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<header class="site-header" id="siteHeader">
    <div class="utility-bar">
        <div class="utility-inner">
            <div class="utility-left">
                <span id="liveDate">MONDAY, 17 AUGUST 2026</span>
                <span class="util-divider">|</span>
                <span id="liveTime">00:00:00 UTC</span>
                <span class="live-dot"></span>
            </div>
            <div class="utility-right">
                <a href="https://facebook.com/thegdesk" target="_blank" rel="noopener"><i class="fa-brands fa-facebook-f"></i></a>
                <a href="https://x.com/thegdeskHQ" target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                </a>
                <a href="https://youtube.com/@thegdesk" target="_blank" rel="noopener"><i class="fa-brands fa-youtube"></i></a>
                <a href="https://instagram.com/thegdesk" target="_blank" rel="noopener"><i class="fa-brands fa-instagram"></i></a>
                <a href="https://tiktok.com/@thegdesk" target="_blank" rel="noopener"><i class="fa-brands fa-tiktok"></i></a>
            </div>
        </div>
    </div>

    <div class="header-main">
        <div class="header-inner">
            <a href="/" class="brand"><img src="/Logo.png" alt="The Global Desk"></a>
            <div class="header-actions">
                <a href="/" class="header-btn">&#8592; Back to Home</a>
            </div>
        </div>
    </div>
</header>

<main class="main-container">
    <section class="article-page" style="margin-top: 40px; max-width: 800px;">
        <h1 class="article-title">{{ title }}</h1>
        <div class="article-body" style="margin-top: 20px;">
            {{ content | safe }}
        </div>
        <div class="article-footer">
            <a href="/" class="read-link">&#8592; Back to Homepage</a>
        </div>
    </section>
</main>

<footer class="site-footer">
    <div class="footer-bottom">
        <span>&copy; 2026 The Global Desk. All Rights Reserved.</span>
        <span>Independent International News Platform</span>
    </div>
</footer>

<script src="/app.js"></script>
</body>
</html>