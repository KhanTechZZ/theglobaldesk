<!-- REAL WORLD MAP: Natural Earth country boundaries -->
<script src="https://cdn.jsdelivr.net/npm/d3@7"></script>
<script>
(function () {
  "use strict";

  const more = document.getElementById("tdgMoreBtn");
  const menu = document.getElementById("tdgMoreMenu");

  if (more && menu) {
    more.addEventListener("click", function (event) {
      event.stopPropagation();
      const opened = menu.classList.toggle("open");
      more.setAttribute("aria-expanded", String(opened));
    });

    document.addEventListener("click", function (event) {
      if (!event.target.closest(".tdg-ref-more")) {
        menu.classList.remove("open");
        more.setAttribute("aria-expanded", "false");
      }
    });
  }

  const mobileBtn = document.getElementById("tdgMobileBtn");
  const mobileNav = document.getElementById("tdgMobileNav");

  if (mobileBtn && mobileNav) {
    mobileBtn.addEventListener("click", function () {
      const opened = mobileNav.classList.toggle("open");
      mobileBtn.setAttribute("aria-expanded", String(opened));
    });
  }

  const regionCategories = {
    "Asia": ["asia"],
    "Europe": ["europe"],
    "Africa": ["africa"],
    "North America": ["north america", "americas"],
    "South America": ["south america", "americas"],
    "Oceania": ["oceania"]
  };

  const regionDescriptions = {
    "Asia": "Explore regional reporting from across Asia.",
    "Europe": "Explore news and analysis from across Europe.",
    "Africa": "Explore developments from across Africa.",
    "North America": "Explore reporting from North America.",
    "South America": "Explore reporting from South America.",
    "Oceania": "Explore Australia and the Pacific region."
  };

  // Prepare published news for map-region filtering.
  const newsItems = [
    {% for story in allNews %}
    {
      title: {{ story.data.title | dump | safe }},
      url: {{ story.url | dump | safe }},
      category: {{ (story.data.category or "World") | dump | safe }},
      date: {{ (story.data.date | readableDate) | dump | safe }}
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ];

  function showRegionNews(region) {
    const list = document.getElementById("tdgRegionNews");
    const title = document.getElementById("tdgSelectedRegion");
    const note = document.getElementById("tdgMapNote");
    if (!list) return;

    if (title) title.textContent = region;
    if (note) note.textContent = regionDescriptions[region] || "";

    const allowed = regionCategories[region] || [];
    const matches = newsItems.filter(function (item) {
      return allowed.includes(String(item.category).toLowerCase().trim());
    }).slice(0, 4);

    if (!matches.length) {
      list.innerHTML = '<li class="tdg-ref-no-region-news"><span>No dedicated stories in this region yet.</span><small>Explore</small></li>';
      return;
    }

    list.innerHTML = matches.map(function (item) {
      const li = document.createElement("li");
      const a = document.createElement("a");
      const small = document.createElement("small");

      a.href = item.url;
      a.textContent = item.title;
      small.textContent = item.date || region;

      li.append(a, small);
      return li.outerHTML;
    }).join("");
  }

  const regionButtons = document.querySelectorAll(".tdg-ref-regions button");

  function selectRegion(region) {
    regionButtons.forEach(function (button) {
      button.classList.toggle("active", button.dataset.region === region);
    });
    showRegionNews(region);

    if (window.tdgSelectMapRegion) {
      window.tdgSelectMapRegion(region);
    }
  }

  regionButtons.forEach(function (button) {
    button.addEventListener("click", function () {
      selectRegion(button.dataset.region);
    });
  });

  const resetButton = document.getElementById("tdgMapReset");
  if (resetButton) {
    resetButton.addEventListener("click", function () {
      if (window.tdgResetWorldMap) window.tdgResetWorldMap();
    });
  }

  // Initial selection.
  showRegionNews("Asia");

  // Draw the actual country geometry from Natural Earth GeoJSON.
  async function loadWorldMap() {
    const svgElement = document.getElementById("tdgMapSvg");
    const layerElement = document.getElementById("tdgMapLayer");
    const loading = document.getElementById("tdgMapLoading");

    if (!svgElement || !layerElement || !window.d3) {
      if (loading) loading.textContent = "World map could not be loaded.";
      return;
    }

    const d3 = window.d3;
    const svg = d3.select(svgElement);
    const layer = d3.select(layerElement);

    const width = 700;
    const height = 360;

    const projection = d3.geoNaturalEarth1()
      .fitExtent([[12, 12], [width - 12, height - 12]], {type: "Sphere"});

    const path = d3.geoPath(projection);

    try {
      const response = await fetch(
        "https://raw.githubusercontent.com/nvkelso/natural-earth-vector/master/geojson/ne_110m_admin_0_countries.geojson"
      );

      if (!response.ok) throw new Error("Map data request failed");

      const world = await response.json();

      const features = world.features.filter(function (feature) {
        return feature.properties && feature.geometry;
      });

      const continentColors = {
        "Asia": "#b68b3c",
        "Europe": "#7992aa",
        "Africa": "#8d9c9b",
        "North America": "#8299ae",
        "South America": "#9b9a80",
        "Oceania": "#9b8d77"
      };

      const countryPaths = layer.selectAll("path")
        .data(features)
        .join("path")
        .attr("class", "tdg-map-country")
        .attr("d", path)
        .attr("fill", function (d) {
          return continentColors[d.properties.CONTINENT] || "#536b82";
        })
        .attr("data-continent", function (d) {
          return d.properties.CONTINENT || "";
        })
        .attr("tabindex", 0)
        .attr("role", "button")
        .attr("aria-label", function (d) {
          return (d.properties.NAME || "Country") + ", " +
            (d.properties.CONTINENT || "Unknown region");
        });

      layer.append("path")
        .datum({type: "Sphere"})
        .attr("class", "tdg-map-outline")
        .attr("d", path);

      const zoom = d3.zoom()
        .scaleExtent([1, 3.1])
        .on("zoom", function (event) {
          layer.attr("transform", event.transform);
        });

      svg.call(zoom);

      const continentCenters = {
        "Asia": [105, 32],
        "Europe": [18, 52],
        "Africa": [20, 0],
        "North America": [-105, 42],
        "South America": [-60, -17],
        "Oceania": [135, -25]
      };

      function activateContinent(region) {
        countryPaths.classed("is-selected", function (d) {
          return d.properties.CONTINENT === region;
        });

        countryPaths.classed("is-dimmed", function (d) {
          return d.properties.CONTINENT !== region;
        });

        const center = continentCenters[region];
        if (!center) return;

        const point = projection(center);
        const scale = 1.75;
        const transform = d3.zoomIdentity
          .translate(width / 2 - point[0] * scale, height / 2 - point[1] * scale)
          .scale(scale);

        svg.transition().duration(750).call(zoom.transform, transform);
      }

      countryPaths
        .on("click", function (event, feature) {
          const continent = feature.properties.CONTINENT;
          if (regionCategories[continent]) {
            selectRegion(continent);
          }
        })
        .on("keydown", function (event, feature) {
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            const continent = feature.properties.CONTINENT;
            if (regionCategories[continent]) selectRegion(continent);
          }
        });

      window.tdgSelectMapRegion = activateContinent;

      window.tdgResetWorldMap = function () {
        countryPaths.classed("is-selected", false).classed("is-dimmed", false);
        svg.transition().duration(650).call(zoom.transform, d3.zoomIdentity);
      };

      if (loading) loading.remove();

      activateContinent("Asia");

    } catch (error) {
      console.error("World map:", error);
      if (loading) loading.textContent = "Map unavailable. Please check your connection.";
    }
  }

  loadWorldMap();

})();
</script>

</body>
</html>