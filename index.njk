<body class="tdg-ref-home">

{% set allNews = collections.news | reverse %}
{% set breakingItems = collections.breaking %}
{% set lead = allNews[0] %}
{% set analysisStory = allNews[5] or lead %}
{% set researchStories = allNews | byCategory("Research") %}{% set researchStory = researchStories[0] or lead %}

<div class="tdg-ad-ribbon" aria-label="Advertisement">
  <div class="tdg-ad-inner">
    <span class="tdg-ad-label">ADVERTISEMENT</span>

    <div class="tdg-ad-media" id="tdgAdMedia" aria-busy="true">
      <div class="tdg-ad-skeleton" id="tdgAdSkeleton">
        <span class="tdg-ad-shimmer"></span>
        <span class="tdg-ad-loading-text">Preparing advertisement...</span>
      </div>

      <img
        id="tdgDelayedAd"
        data-src="/images/nova-tech-ad-banner.png"
        alt="NOVA TECH &mdash; Smarter Technology. A Brighter Tomorrow."
        decoding="async">
    </div>
  </div>
</div>

<script>
(function () {
  "use strict";

  const ad = document.getElementById("tdgDelayedAd");
  const media = document.getElementById("tdgAdMedia");
  const skeleton = document.getElementById("tdgAdSkeleton");

  if (!ad || !media || !skeleton) return;

  setTimeout(function () {
    ad.onload = function () {
      ad.classList.add("is-loaded");
      media.setAttribute("aria-busy", "false");
      skeleton.remove();
    };

    ad.onerror = function () {
      skeleton.textContent = "Advertisement unavailable.";
      media.setAttribute("aria-busy", "false");
    };

    ad.src = ad.dataset.src;
  }, 3000);
})();
</script>
<header class="tdg-ref-header" id="siteHeader">
  <div class="tdg-ref-head-inner">

    <a class="tdg-ref-brand" href="/" aria-label="The Global Desk Home">
      <img src="/Logo.png" alt="The Global Desk">
    </a>

    <nav class="tdg-ref-nav" aria-label="Main navigation">
      <a class="is-active" href="/">Home</a>
      <a href="/category/world/">World</a>
      <a href="/category/economy/">Business</a>
      <a href="/category/politics/">Politics</a>
      <a href="/category/science/">Science</a>
      <a href="/category/tech-and-ai/">Technology</a>
      <a href="/category/explainer/">Analysis</a>

      <div class="tdg-ref-more">
        <button type="button" aria-expanded="false" id="tdgMoreBtn">
          More <span>&#9662;</span>
        </button>

        <div class="tdg-ref-dropdown" id="tdgMoreMenu">
          <a href="/category/asia/">Asia</a>
          <a href="/category/environment/">Environment</a>
          <a href="/category/research/">Research</a>
          <a href="/category/human-rights/">Human Rights</a>
          <a href="/z-desk/">Z Desk</a>
          <a href="/alpha-desk/">AlphaDesk</a>
        </div>
      </div>
    </nav>

    <div class="tdg-ref-tools">
      <a href="/search/" aria-label="Search">&#128269;</a>
      <button id="tdgMobileBtn" type="button" aria-label="Open menu" aria-expanded="false">&#9776;</button>
    </div>

  </div>

  <nav class="tdg-ref-mobile" id="tdgMobileNav" aria-label="Mobile navigation">
    <a href="/">Home</a>
    <a href="/category/world/">World</a>
    <a href="/category/asia/">Asia</a>
    <a href="/category/economy/">Business</a>
    <a href="/category/politics/">Politics</a>
    <a href="/category/science/">Science</a>
    <a href="/category/tech-and-ai/">Technology</a>
    <a href="/category/explainer/">Analysis</a>
    <a href="/category/research/">Research</a>
    <a href="/z-desk/">Z Desk</a>
    <a href="/alpha-desk/">AlphaDesk</a>
    <a href="/category/environment/">Environment</a>
    <a href="/category/human-rights/">Human Rights</a>
  </nav>
</header>


<!-- BREAKING NEWS -->

{% if breakingItems and breakingItems.length %}
<div class="tdg-ref-breaking" id="breakingBar">
  <div class="tdg-ref-breaking-label"><i></i> BREAKING</div>

  <div class="tdg-ref-breaking-window" id="breakingTrack">
    <div class="tdg-ref-breaking-text" id="breakingNews">
      {% for item in breakingItems %}
        <a href="{{ item.url }}">{{ item.data.title }}</a>
        {% if not loop.last %}<span> &bull; </span>{% endif %}
      {% endfor %}
    </div>
  </div>

  <a class="tdg-ref-live" href="/category/world/"><i></i> LIVE</a>
  <button class="tdg-ref-breaking-next" id="breakingNext" type="button" aria-label="Next breaking news">&rsaquo;</button>
</div>
{% else %}
<div class="tdg-ref-breaking" id="breakingBar">
  <div class="tdg-ref-breaking-label"><i></i> BREAKING</div>
  <div class="tdg-ref-breaking-window" id="breakingTrack">
    <div class="tdg-ref-breaking-text" id="breakingNews">
      <a href="/category/world/" id="breakingLink">The Global Desk &#8212; Latest global updates</a>
    </div>
  </div>
  <a class="tdg-ref-live" href="/category/world/"><i></i> LIVE</a>
  <button class="tdg-ref-breaking-next" id="breakingNext" type="button" aria-label="Next breaking news">&rsaquo;</button>
</div>
{% endif %}



<section class="tdg-trending-strip" aria-label="Trending stories">
  <div class="tdg-trending-label"><span></span> TRENDING</div>
  <div class="tdg-trending-items">
    {% for story in allNews %}
      {% if loop.index <= 4 %}
      <a href="{{ story.url }}">
        <span class="tdg-trending-number">0{{ loop.index }}</span>
        <span>{{ story.data.title }}</span>
      </a>
      {% endif %}
    {% endfor %}
  </div>
</section>
<main class="tdg-ref-main">

{% if allNews.length %}

  <!-- LEAD NEWSROOM -->

  <section class="tdg-ref-lead-grid">

    <div class="tdg-live-left-column">
    <section class="tdg-live-desk" aria-label="Global Live Desk">

  {% set liveCoverage = collections.liveCoverage[0] %}

  <!-- HEADER -->
  <div class="tdg-live-desk-heading">
    <h2>GLOBAL LIVE DESK</h2>
    {% if liveCoverage %}
      <span class="tdg-live-status">
        <i></i> LIVE
      </span>
    {% else %}
      <span class="tdg-live-status tdg-live-standby">
        <i></i> STANDBY
      </span>
    {% endif %}
  </div>

  {% if liveCoverage %}

    <!-- FEATURED LIVE EVENT -->
    <div class="tdg-live-feature">

      <a class="tdg-live-feature-image" href="{{ liveCoverage.url }}">
        <img
          src="{{ liveCoverage.data.image or '/images/default-news.jpg' }}"
          alt="{{ liveCoverage.data.title }}"
          loading="lazy"
        >
      </a>

      <div class="tdg-live-feature-copy">

        <span class="tdg-live-category">
          {{ liveCoverage.data.category or "LIVE COVERAGE" }}
        </span>

        <h3>
          <a href="{{ liveCoverage.url }}">
            {{ liveCoverage.data.title }}
          </a>
        </h3>

        <div class="tdg-live-dates">

          {% if liveCoverage.data.started %}
            <div>
              <span>Started:</span>
              <strong>{{ liveCoverage.data.started | timeAgo }}</strong>
            </div>
          {% endif %}

          {% if liveCoverage.data.updated %}
            <div>
              <span>Updated:</span>
              <strong>{{ liveCoverage.data.updated | timeAgo }}</strong>
            </div>
          {% elif liveCoverage.data.started %}
            <div>
              <span>Updated:</span>
              <strong>{{ liveCoverage.data.started | timeAgo }}</strong>
            </div>
          {% endif %}

        </div>

      </div>

    </div>

    <!-- REAL EVENT TIMELINE -->
    {% if liveCoverage.data.updates and liveCoverage.data.updates.length %}

      <div class="tdg-live-timeline">

        {% for item in liveCoverage.data.updates | reverse %}

          {% if loop.index <= 4 %}

            <a
              class="tdg-live-update {% if loop.first %}is-latest{% endif %}"
              href="{{ liveCoverage.url }}"
            >

              <span class="tdg-live-update-dot"></span>

              <div class="tdg-live-update-content">

                {% if item.date %}
                  <span class="tdg-live-update-time">
                    {{ item.date | timeAgo }}
                  </span>
                {% endif %}

                <strong>{{ item.title }}</strong>

              </div>

            </a>

          {% endif %}

        {% endfor %}

      </div>

    {% endif %}

    <!-- COVERAGE LINK -->
    <a class="tdg-live-footer" href="{{ liveCoverage.url }}">
      <span>VIEW ALL UPDATES</span>
      <b>&rarr;</b>
    </a>

  {% else %}

    <!-- ✅ NEW: Professional Empty State -->
    <div class="tdg-live-empty-state">
      <svg class="tdg-live-empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="12" cy="12" r="3"/>
        <path d="M12 1v3M12 20v3M1 12h3M20 12h3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/>
      </svg>
      <h3>Monitoring Global Events</h3>
      <p>Our newsroom is actively tracking world events. When breaking coverage begins, updates will appear here in real-time.</p>
      <a href="/news/" class="tdg-live-empty-link">
        <span>Browse Latest News</span>
        <b>&rarr;</b>
      </a>
    </div>

  {% endif %}

</section>

</div><article class="tdg-ref-hero">
      <a href="{{ lead.url }}">

        <img
          src="{% set fallbackImage = lead.data.image or lead.data.image or '/Logo.png' %}{% if fallbackImage[0] !== '/' and fallbackImage.slice(0,4) !== 'http' %}/{{ fallbackImage }}{% else %}{{ fallbackImage }}{% endif %}"
          alt="{{ lead.data.title }}"
          fetchpriority="high">

        <span class="tdg-ref-tag">{{ lead.data.category or "WORLD" }}</span>

        <div class="tdg-ref-hero-copy">
          <h1>{{ lead.data.title }}</h1>
          <p>{{ lead.data.description }}</p>
          <div class="tdg-ref-meta">
            <span class="time-ago" data-published="{{ lead.data.date | isoDate }}">
              {{ lead.data.date | readableDate }}
            </span>
            <b>Read full story&nbsp; &rarr;</b>
          </div>
        </div>
      </a>
    </article>
</section>

<section class="tdg-l-news-section" aria-label="Latest News">

  <div class="tdg-l-news-heading">
    <div>
      <span>THE GLOBAL DESK</span>
      <h2>Latest News</h2>
    </div>

    <a href="/news/">VIEW ALL NEWS &rarr;</a>
  </div>

  {% set latestStories = allNews.slice(1, 9) %}

  {% if latestStories.length %}

    <div class="tdg-l-news-grid">

      {% for story in latestStories %}

        <article class="tdg-l-news-card">

          <a class="tdg-l-news-image" href="{{ story.url }}">
            <img
              src="{% set fallbackImage = story.data.image or '/Logo.png' %}{% if fallbackImage[0] !== '/' and fallbackImage.slice(0,4) !== 'http' %}/{{ fallbackImage }}{% else %}{{ fallbackImage }}{% endif %}"
              alt="{{ story.data.title }}"
              loading="lazy">
          </a>

          <div class="tdg-l-news-copy">

            <span class="tdg-l-news-category">
              {{ story.data.category or "NEWS" }}
            </span>

            <h3>
              <a href="{{ story.url }}">
                {{ story.data.title }}
              </a>
            </h3>

            {% if story.data.description %}
              <p>{{ story.data.description }}</p>
            {% endif %}

            <div class="tdg-l-news-meta">
              <span>{{ story.data.date | readableDate }}</span>
              <b>READ STORY &rarr;</b>
            </div>

          </div>

        </article>

      {% endfor %}

    </div>

  {% endif %}

</section>

<!-- EDITORIAL SELECTION -->
<section class="tdg-ref-section tdg-editors-picks">
  <div class="tdg-ref-section-head">
    <div>
      <span class="tdg-ref-eyebrow">THE EDITORIAL SELECTION</span>
      <h2>Editor's Picks</h2>
    </div>
    <span class="tdg-editor-note">Selected stories from our newsroom</span>
  </div>

  <div class="tdg-editor-grid">
    {% for story in allNews %}
      {% if loop.index > 2 and loop.index <= 5 %}
      <article class="tdg-editor-card">
        <a class="tdg-editor-image" href="{{ story.url }}">
          <img src="{% set fallbackImage = story.data.image or lead.data.image or '/Logo.png' %}{% if fallbackImage[0] !== '/' and fallbackImage.slice(0,4) !== 'http' %}/{{ fallbackImage }}{% else %}{{ fallbackImage }}{% endif %}" alt="{{ story.data.title }}" loading="lazy">
        </a>
        <div class="tdg-editor-copy">
          <span>{{ story.data.category or "WORLD" }}</span>
          <h3><a href="{{ story.url }}">{{ story.data.title }}</a></h3>
          <small>{{ story.data.date | readableDate }}</small>
        </div>
      </article>
      {% endif %}
    {% endfor %}
  </div>
</section>
<!-- MORE GLOBAL STORIES -->
<section class="tdg-ref-more tdg-more-editorial">
  <div class="tdg-ref-section-heading">
    <div>
      <span class="tdg-ref-eyebrow">DISCOVER MORE</span>
      <h2>More from The Global Desk</h2>
    </div>
    <a href="/category/world/">Explore all coverage &rarr;</a>
  </div>

  <div class="tdg-more-grid">
    {% for story in allNews %}
      {% if loop.index <= 3 %}
        {% set moreImage = story.data.image or lead.data.image or '/Logo.png' %}
        <a class="tdg-more-card" href="{{ story.url }}">
          <div class="tdg-more-image">
            <img src="{{ moreImage }}" alt="{{ story.data.title }}" loading="lazy">
          </div>
          <span class="tdg-ref-eyebrow">{{ story.data.category or 'GLOBAL NEWS' }}</span>
          <h3>{{ story.data.title }}</h3>
          <span class="tdg-more-read">Read story &rarr;</span>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</section>
{% endif %}

