---
layout: category.njk
pagination:
  data: sectionPages
  size: 1
  alias: sectionPage
permalink: "/{{ sectionPage.base }}/{{ sectionPage.slug }}/"
eleventyExcludeFromCollections: true
---

{% set sectionTitle = sectionPage.title %}
{% if sectionPage.category %}
  {% set sectionPosts = collections.publishedNews | byCategory(sectionPage.category) %}
{% else %}
  {% set sectionPosts = collections.publishedNews | byFormat(sectionPage.format) %}
{% endif %}

<main class="gd-container gd-article-page gd-category-page gd-section-page">
  <div class="gd-article-breadcrumb">
    <a href="/">Home</a> / <span>{{ sectionTitle }}</span>
  </div>

  <header class="gd-category-heading">
    <h1 class="gd-article-title">{{ sectionTitle }}</h1>
    <p class="gd-article-description">Latest stories and coverage from {{ sectionTitle }}.</p>
  </header>

  {% if sectionPosts.length %}
  <div class="gd-latest__grid">
    {% for post in sectionPosts %}
    <article class="gd-news-card">
      <a href="{{ post.url }}" class="gd-news-card__link">
        <div class="gd-news-card__media">
          {% if post.data.image %}<img src="{{ post.data.image }}" alt="{{ post.data.title }}" loading="lazy">{% else %}<span class="gd-image-placeholder gd-category-image-placeholder" data-label="{{ sectionTitle | upper }}" aria-hidden="true"></span>{% endif %}
        </div>
        <div class="gd-news-card__body">
          <span class="gd-story-meta">{{ post.data.category }} | <time datetime="{{ (post.data.publishedAt or post.date) | isoDate }}" data-relative-time data-date-only="{% if not post.data.publishedAt %}true{% else %}false{% endif %}">{{ (post.data.publishedAt or post.date) | relativeDate }}</time></span><h3>{{ post.data.title }}</h3>
          <p>{{ post.data.description }}</p>
          
        </div>
      </a>
    </article>
    {% endfor %}
  </div>
  {% else %}
  <div class="gd-category-empty">
    <h2>Coverage is on the way</h2>
    <p>There are no published stories in this section yet. Please check back soon.</p>
  </div>
  {% endif %}

  <a class="gd-article-back" href="/">‹ Back</a>
</main>


