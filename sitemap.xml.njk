---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    <url>
        <loc>https://thegdesk.com/</loc>
        <changefreq>daily</changefreq>
        <priority>1.0</priority>
    </url>
    {% for item in [{path:"/about/", lastmod:"2026-11-26"}, {path:"/contact/", lastmod:"2026-11-26"}, {path:"/editorial-policy/", lastmod:"2026-11-26"}, {path:"/privacy/"}, {path:"/archive/"}, {path:"/category/z-desk/"}, {path:"/category/alpha-desk/"}] %}
    <url>
        <loc>https://thegdesk.com{{ item.path }}</loc>
        {% if item.lastmod %}<lastmod>{{ item.lastmod }}</lastmod>{% endif %}
    </url>
    {% endfor %}
    {% for story in collections.news | reverse %}
    {% if story.data.published %}
    <url>
        <loc>{{ story.url | absoluteUrl("https://thegdesk.com") }}</loc>
        <lastmod>{{ story.date | isoDate }}</lastmod>
    </url>
    {% endif %}
    {% endfor %}
</urlset>
