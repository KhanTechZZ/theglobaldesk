---
permalink: /trending-today/
layout: static-page.njk
title: "Trending Today"
lastModified: 2026-11-27
description: "Explore the searches drawing the most attention around the world, ranked by activity across 37 markets."
---

<section class="gd-trending-page" aria-label="Trending searches around the world">
  <div class="gd-trending-page__summary" data-trending-page-summary>Loading trending searches…</div>
  <div class="gd-trending-page__list" data-trending-page-list aria-live="polite" aria-busy="true">
    <p class="gd-trending-loading">Loading current trends…</p>
  </div>
</section>

<script>
  (function () {
    var list = document.querySelector('[data-trending-page-list]');
    var summary = document.querySelector('[data-trending-page-summary]');
    if (!list || !summary) return;

    function render(data) {
      if (!Array.isArray(data.topics)) throw new Error('No trends returned');
      list.replaceChildren();
      if (!data.topics.length) {
        var empty = document.createElement('p');
        empty.className = 'gd-trending-loading';
        empty.textContent = 'No trending topics are available right now.';
        list.appendChild(empty);
        summary.textContent = 'No current searches to show';
        list.setAttribute('aria-busy', 'false');
        return;
      }
      summary.textContent = data.topics.length + ' topics · ranked by search activity';
      data.topics.forEach(function (topic, index) {
        var link = document.createElement('a');
        link.className = 'gd-trending-topic';
        link.href = topic.url || '#';
        link.target = '_blank';
        link.rel = 'noopener noreferrer';

        var rank = document.createElement('span');
        rank.className = 'gd-trending-topic__rank';
        rank.textContent = String(index + 1).padStart(2, '0');
        var category = document.createElement('span');
        category.className = 'gd-trending-topic__category';
        category.textContent = topic.category || 'World';
        var title = document.createElement('span');
        title.className = 'gd-trending-topic__title';
        title.textContent = topic.title;
        var meta = document.createElement('span');
        meta.className = 'gd-trending-topic__regions';
        var marketCount = topic.marketCount || (topic.markets || []).length;
        var marketLabel = marketCount === 1 ? (topic.markets || ['1 country'])[0] : marketCount + ' countries';
        meta.textContent = [topic.volume, marketLabel].filter(Boolean).join(' · ');
        link.append(rank, category, title, meta);
        list.appendChild(link);
      });
      list.setAttribute('aria-busy', 'false');
    }

    function showUnavailable() {
      list.replaceChildren();
      var message = document.createElement('p');
      message.className = 'gd-trending-loading';
      message.textContent = 'Trends are temporarily unavailable. Please check back shortly.';
      list.appendChild(message);
      summary.textContent = 'Searches could not be loaded';
      list.setAttribute('aria-busy', 'false');
    }

    fetch('/trending.json?refresh=' + Date.now(), { cache: 'no-store' })
      .then(function (response) { if (!response.ok) throw new Error('Trends unavailable'); return response.json(); })
      .then(render)
      .catch(showUnavailable);
  })();
</script>
