---
permalink: /trending-today/
layout: static-page.njk
title: "Trending Today"
lastModified: 2026-11-27
description: "Explore the searches drawing the most attention around the world, ranked by activity across 37 markets."
---

<section class="gd-trending-page" aria-label="Trending searches around the world">
  <div class="gd-trending-filters" aria-label="Filter trending topics">
    <label class="gd-trending-filter"><span>Country</span><select data-trending-country><option value="">All countries</option></select></label>
  </div>
  <div class="gd-trending-page__summary" data-trending-page-summary>Loading trending searches…</div>
  <div class="gd-trending-page__list" data-trending-page-list aria-live="polite" aria-busy="true">
    <p class="gd-trending-loading">Loading current trends…</p>
  </div>
</section>

<script>
  (function () {
    var list = document.querySelector('[data-trending-page-list]');
    var summary = document.querySelector('[data-trending-page-summary]');
    var countryFilter = document.querySelector('[data-trending-country]');
    if (!list || !summary || !countryFilter) return;
    var allTopics = [];
    var compactNumber = new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 });

    function addOptions(select, values) {
      values.forEach(function (value) {
        var option = document.createElement('option');
        option.value = value;
        option.textContent = value;
        select.appendChild(option);
      });
    }

    function render(data) {
      if (!Array.isArray(data.topics)) throw new Error('No trends returned');
      allTopics = data.topics;
      addOptions(countryFilter, (data.sourcesAvailable || []).slice().sort(function (a, b) { return a.localeCompare(b); }));
      drawTopics();
    }

    function drawTopics() {
      var country = countryFilter.value;
      var topics = allTopics.filter(function (topic) {
        return !country || (topic.markets || []).indexOf(country) !== -1;
      });
      if (country) topics.sort(function (a, b) { return ((b.marketVolumes || {})[country] || 0) - ((a.marketVolumes || {})[country] || 0); });
      list.replaceChildren();
      summary.textContent = 'Showing ' + topics.length + ' of ' + allTopics.length + (country ? ' topics in ' + country : ' topics') + ' · ranked by search volume';
      if (!topics.length) {
        var empty = document.createElement('p');
        empty.className = 'gd-trending-loading';
        empty.textContent = 'No topics match this country. Try another country.';
        list.appendChild(empty);
        list.setAttribute('aria-busy', 'false');
        return;
      }
      topics.forEach(function (topic, index) {
        var link = document.createElement('a');
        link.className = 'gd-trending-topic';
        link.href = topic.url || '#';
        link.target = '_blank';
        link.rel = 'noopener noreferrer';

        var rank = document.createElement('span');
        rank.className = 'gd-trending-topic__rank';
        rank.textContent = String(index + 1).padStart(2, '0');
        var title = document.createElement('span');
        title.className = 'gd-trending-topic__title';
        title.textContent = topic.title;
        var volume = document.createElement('span');
        volume.className = 'gd-trending-topic__volume';
        var volumeValue = country ? (topic.marketVolumes || {})[country] : null;
        volume.textContent = volumeValue ? compactNumber.format(volumeValue) + '+' : String(topic.volume || '').replace(/\s+searches?$/i, '');
        var meta = document.createElement('span');
        meta.className = 'gd-trending-topic__regions';
        var marketCount = topic.marketCount || (topic.markets || []).length;
        var marketLabel = country || (marketCount === 1 ? (topic.markets || ['1 country'])[0] : marketCount + ' countries');
        meta.textContent = ['searches', marketLabel].filter(Boolean).join(' · ');
        link.append(rank, title, volume, meta);
        list.appendChild(link);
      });
      list.setAttribute('aria-busy', 'false');
    }

    function showUnavailable() {
      list.replaceChildren();
      var message = document.createElement('p');
      message.className = 'gd-trending-loading';
      message.textContent = 'Trends are temporarily unavailable. Please check back shortly.';
      list.appendChild(message);
      summary.textContent = 'Searches could not be loaded';
      list.setAttribute('aria-busy', 'false');
    }

    fetch('/trending.json?refresh=' + Date.now(), { cache: 'no-store' })
      .then(function (response) { if (!response.ok) throw new Error('Trends unavailable'); return response.json(); })
      .then(render)
      .catch(showUnavailable);
    countryFilter.addEventListener('change', drawTopics);
  })();
</script>
