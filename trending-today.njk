---
permalink: /trending-today/
layout: static-page.njk
title: "Trending Today"
lastModified: 2026-11-27
description: "Live Google Trends searches and rising topics from 37 markets."
---

<section class="gd-trending-page" aria-label="Trending searches around the world">
  <div class="gd-trending-toolbar" aria-label="Filter trending topics">
    <label class="gd-trending-filter"><span>Country</span><select data-trending-country><option value="">Worldwide</option></select></label>
    <label class="gd-trending-filter"><span>Topic</span><select data-trending-category><option value="">All topics</option></select></label>
    <label class="gd-trending-filter"><span>Status</span><select data-trending-status><option value="">All trends</option><option value="active">Active now</option><option value="ended">Recently ended</option></select></label>
    <label class="gd-trending-filter"><span>Sort by</span><select data-trending-sort><option value="volume">Search volume</option><option value="recent">Recently started</option><option value="reach">Most countries</option></select></label>
    <div class="gd-trending-live">
      <span class="gd-trending-live__status"><i aria-hidden="true"></i>Live</span>
      <time class="gd-trending-updated" data-trending-updated>Updated —</time>
    </div>
  </div>
  <div class="gd-trending-page__summary" data-trending-page-summary>Loading trends…</div>
  <div class="gd-trending-table" role="table" aria-label="Live trending searches">
    <div class="gd-trending-table__head" role="row">
      <span role="columnheader">Trend</span>
      <span role="columnheader">Search volume</span>
      <span role="columnheader">Started</span>
      <span role="columnheader">Cross-border reach</span>
      <span role="columnheader">Trend breakdown</span>
      <span role="columnheader">Past 24 hours</span>
    </div>
    <div class="gd-trending-page__list" data-trending-page-list role="rowgroup" aria-live="polite" aria-busy="true">
      <p class="gd-trending-loading">Loading current trends…</p>
    </div>
  </div>
</section>

<script>
  (function () {
    var list = document.querySelector('[data-trending-page-list]');
    var summary = document.querySelector('[data-trending-page-summary]');
    var countryFilter = document.querySelector('[data-trending-country]');
    var categoryFilter = document.querySelector('[data-trending-category]');
    var statusFilter = document.querySelector('[data-trending-status]');
    var sortFilter = document.querySelector('[data-trending-sort]');
    var updated = document.querySelector('[data-trending-updated]');
    if (!list || !summary || !countryFilter || !categoryFilter || !statusFilter || !sortFilter) return;
    var allTopics = [];
    var totalMarkets = 37;
    var compactNumber = new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 });
    var regularNumber = new Intl.NumberFormat('en-US', { maximumFractionDigits: 0 });
    var categories = ['Global conflicts', 'Politics', 'Economy', 'Climate & disasters', 'Health', 'Science & technology', 'Sports', 'Entertainment', 'Other current affairs'];
    var svgNamespace = 'http://www.w3.org/2000/svg';
    var latestUpdate = null;
    var countryTimeZones = {
      'Bangladesh':'Asia/Dhaka','India':'Asia/Kolkata','Pakistan':'Asia/Karachi','Indonesia':'Asia/Jakarta','Singapore':'Asia/Singapore',
      'Thailand':'Asia/Bangkok','Philippines':'Asia/Manila','Japan':'Asia/Tokyo','South Korea':'Asia/Seoul','Australia':'Australia/Sydney',
      'New Zealand':'Pacific/Auckland','United States':'America/New_York','Canada':'America/Toronto','Mexico':'America/Mexico_City',
      'Brazil':'America/Sao_Paulo','Argentina':'America/Argentina/Buenos_Aires','Chile':'America/Santiago','Colombia':'America/Bogota',
      'United Kingdom':'Europe/London','Ireland':'Europe/Dublin','France':'Europe/Paris','Germany':'Europe/Berlin','Spain':'Europe/Madrid',
      'Italy':'Europe/Rome','Netherlands':'Europe/Amsterdam','Poland':'Europe/Warsaw','Sweden':'Europe/Stockholm','Ukraine':'Europe/Kyiv',
      'Russia':'Europe/Moscow','Türkiye':'Europe/Istanbul','Saudi Arabia':'Asia/Riyadh','United Arab Emirates':'Asia/Dubai',
      'Egypt':'Africa/Cairo','Nigeria':'Africa/Lagos','Kenya':'Africa/Nairobi','Ghana':'Africa/Accra','South Africa':'Africa/Johannesburg'
    };

    function addOptions(select, values) {
      values.forEach(function (value) {
        var option = document.createElement('option');
        option.value = value;
        option.textContent = value;
        select.appendChild(option);
      });
    }

    function relativeStart(value) {
      if (!value) return '—';
      var hours = Math.max(0, Math.floor((Date.now() - new Date(value).getTime()) / 3600000));
      if (hours < 1) return 'Less than 1 hour ago';
      if (hours < 24) return hours + (hours === 1 ? ' hour ago' : ' hours ago');
      var days = Math.floor(hours / 24);
      return days + (days === 1 ? ' day ago' : ' days ago');
    }

    function selectedTimeZone() {
      return countryFilter.value ? countryTimeZones[countryFilter.value] : Intl.DateTimeFormat().resolvedOptions().timeZone;
    }

    function localDateTime(value, timeZone) {
      if (!value) return '—';
      return new Intl.DateTimeFormat('en-GB', { timeZone: timeZone, day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date(value));
    }

    function updateLocalTime() {
      if (updated && latestUpdate && !isNaN(latestUpdate.getTime())) {
        var zone = selectedTimeZone();
        updated.textContent = 'Updated · ' + localDateTime(latestUpdate, zone).replace(', ', ' · ');
        updated.setAttribute('datetime', latestUpdate.toISOString());
      }
    }

    function makeSparkline(topic, start, growth, active) {
      var width = 124;
      var height = 42;
      var points = [];
      var started = start ? new Date(start).getTime() : Date.now() - 6 * 3600000;
      var hoursAgo = Math.max(0, Math.min(24, (Date.now() - started) / 3600000));
      var startIndex = Math.max(0, Math.min(11, Math.round((24 - hoursAgo) / 24 * 11)));
      var seed = Array.from(topic.title).reduce(function (sum, char) { return (sum * 31 + char.charCodeAt(0)) >>> 0; }, 17);
      var strength = Math.max(0.25, Math.min(1, Math.log10(Math.max(1, growth)) / 3));
      var peak = 9 + (seed % 10);
      var tail = active ? 25 + (seed % 8) : 34 + (seed % 7);
      for (var i = 0; i < 15; i++) {
        var y = 36;
        if (i >= startIndex) {
          var progress = (i - startIndex) / Math.max(1, 14 - startIndex);
          var rise = Math.min(1, progress * 5.2);
          var settle = active ? progress * 0.34 : progress * 0.78;
          var wave = Math.sin((i + seed % 5) * 1.65) * 2.1 + Math.cos((i + seed % 3) * .73) * 1.2;
          y = 36 - rise * strength * (36 - peak) + settle * (tail - peak) + wave;
        }
        y = Math.max(5, Math.min(37, y));
        points.push([2 + i * 8.55, y]);
      }
      var line = points.map(function (point, index) { return (index ? 'L' : 'M') + point[0].toFixed(1) + ',' + point[1].toFixed(1); }).join(' ');
      var area = line + ' L' + points[points.length - 1][0].toFixed(1) + ',41 L2,41 Z';
      var svg = document.createElementNS(svgNamespace, 'svg');
      svg.setAttribute('viewBox', '0 0 ' + width + ' ' + height);
      svg.setAttribute('role', 'img');
      svg.setAttribute('aria-label', 'Trend activity over the past 24 hours');
      svg.classList.add('gd-trending-sparkline');
      var fill = document.createElementNS(svgNamespace, 'path');
      fill.setAttribute('d', area);
      fill.setAttribute('class', 'gd-trending-sparkline__fill');
      var stroke = document.createElementNS(svgNamespace, 'path');
      stroke.setAttribute('d', line);
      stroke.setAttribute('class', 'gd-trending-sparkline__line');
      svg.append(fill, stroke);
      return svg;
    }

    function buildRow(topic, country, rank) {
      var item = document.createElement('div');
      item.className = 'gd-trending-row';
      item.setAttribute('role', 'row');

      var selectedStart = country ? (topic.marketStartedAt || {})[country] : topic.startedAt;
      var selectedEnd = country ? (topic.marketEndedAt || {})[country] : null;
      var selectedActive = country ? !selectedEnd : topic.active;
      var selectedGrowth = country ? (topic.marketGrowth || {})[country] : topic.growth;
      var selectedVolume = country ? (topic.marketVolumes || {})[country] : topic.volumeValue;

      var trendCell = document.createElement('div');
      trendCell.className = 'gd-trending-row__trend';
      trendCell.setAttribute('role', 'cell');
      var rankLabel = document.createElement('span');
      rankLabel.className = 'gd-trending-row__rank';
      rankLabel.textContent = String(rank).padStart(2, '0');
      var title = document.createElement('span');
      title.className = 'gd-trending-row__title';
      title.textContent = topic.title;
      var state = document.createElement('span');
      state.className = 'gd-trending-row__state' + (selectedActive ? ' is-active' : '');
      state.textContent = selectedActive ? 'Active' : 'Ended';
      trendCell.append(rankLabel, title, state);

      var volumeCell = document.createElement('div');
      volumeCell.className = 'gd-trending-row__volume-cell';
      volumeCell.setAttribute('role', 'cell');
      var volume = document.createElement('strong');
      volume.className = 'gd-trending-row__volume';
      volume.textContent = compactNumber.format(Number(selectedVolume) || 0) + '+';
      var growth = document.createElement('span');
      growth.className = 'gd-trending-row__growth';
      growth.textContent = Number(selectedGrowth) > 0 ? '↑ ' + regularNumber.format(Number(selectedGrowth)) + '%' : '—';
      volumeCell.append(volume, growth);

      var startCell = document.createElement('div');
      startCell.className = 'gd-trending-row__started';
      startCell.setAttribute('role', 'cell');
      var since = document.createElement('strong');
      since.textContent = relativeStart(selectedStart);
      var localStart = document.createElement('small');
      localStart.textContent = localDateTime(selectedStart, selectedTimeZone());
      startCell.append(since, localStart);

      var reachCell = document.createElement('div');
      reachCell.className = 'gd-trending-row__reach';
      reachCell.setAttribute('role', 'cell');
      var reachLabel = document.createElement('strong');
      var reached = Number(topic.marketCount || (topic.markets || []).length);
      reachLabel.textContent = reached + (reached === 1 ? ' country' : ' countries');
      var reachBar = document.createElement('span');
      reachBar.className = 'gd-trending-reach-bar';
      reachBar.setAttribute('aria-label', reached + ' of ' + totalMarkets + ' countries');
      var reachFill = document.createElement('i');
      reachFill.style.width = Math.max(4, Math.min(100, reached / totalMarkets * 100)) + '%';
      reachBar.appendChild(reachFill);
      reachCell.append(reachLabel, reachBar);

      var breakdownCell = document.createElement('div');
      breakdownCell.className = 'gd-trending-row__breakdown';
      breakdownCell.setAttribute('role', 'cell');
      var breakdownItems = country ? ((topic.marketBreakdown || {})[country] || []) : (topic.breakdown || []);
      var breakdown = breakdownItems.slice(0, 2);
      breakdown.forEach(function (query) {
        var chip = document.createElement('span');
        chip.className = 'gd-trending-query';
        chip.textContent = query;
        breakdownCell.appendChild(chip);
      });
      var extra = breakdownItems.length - breakdown.length;
      if (extra > 0) {
        var more = document.createElement('span');
        more.className = 'gd-trending-query-more';
        more.textContent = '+ ' + extra + ' more';
        breakdownCell.appendChild(more);
      }
      if (!breakdown.length) breakdownCell.textContent = '—';

      var graphCell = document.createElement('div');
      graphCell.className = 'gd-trending-row__graph';
      graphCell.setAttribute('role', 'cell');
      graphCell.appendChild(makeSparkline(topic, selectedStart, selectedGrowth, selectedActive));

      item.append(trendCell, volumeCell, startCell, reachCell, breakdownCell, graphCell);
      return item;
    }

    function render(data) {
      if (!Array.isArray(data.topics)) throw new Error('No trends returned');
      allTopics = data.topics;
      totalMarkets = (data.sourcesAvailable || []).length || 37;
      addOptions(countryFilter, (data.sourcesAvailable || []).slice().sort(function (a, b) { return a.localeCompare(b); }));
      var available = categories.filter(function (category) { return allTopics.some(function (topic) { return topic.category === category; }); });
      addOptions(categoryFilter, available);
      var updatedDate = data.updatedAt ? new Date(data.updatedAt) : null;
      latestUpdate = updatedDate;
      updateLocalTime();
      drawTopics();
    }

    function drawTopics() {
      var country = countryFilter.value;
      var category = categoryFilter.value;
      var status = statusFilter.value;
      var sort = sortFilter.value;
      var topics = allTopics.filter(function (topic) {
        var active = country ? !(topic.marketEndedAt || {})[country] : topic.active !== false;
        return (!country || (topic.markets || []).indexOf(country) !== -1) && (!category || topic.category === category) && (!status || (status === 'active' ? active : !active));
      });
      topics.sort(function (a, b) {
        var aVolume = country ? ((a.marketVolumes || {})[country] || 0) : (a.volumeValue || 0);
        var bVolume = country ? ((b.marketVolumes || {})[country] || 0) : (b.volumeValue || 0);
        var aStart = new Date(country ? ((a.marketStartedAt || {})[country] || 0) : (a.startedAt || 0)).getTime();
        var bStart = new Date(country ? ((b.marketStartedAt || {})[country] || 0) : (b.startedAt || 0)).getTime();
        var reachDifference = Number(b.marketCount || (b.markets || []).length) - Number(a.marketCount || (a.markets || []).length);
        return sort === 'recent' ? bStart - aStart || bVolume - aVolume : sort === 'reach' ? reachDifference || bVolume - aVolume : bVolume - aVolume;
      });
      list.replaceChildren();
      var crossBorder = topics.filter(function (topic) { return Number(topic.marketCount || (topic.markets || []).length) > 1; }).length;
      summary.textContent = topics.length.toLocaleString('en-US') + (country ? ' trends in ' + country : ' worldwide trends') + ' · ' + crossBorder.toLocaleString('en-US') + ' crossing borders';
      if (!topics.length) {
        var empty = document.createElement('p');
        empty.className = 'gd-trending-loading';
        empty.textContent = 'No trends match these filters. Try another selection.';
        list.appendChild(empty);
      } else {
        topics.forEach(function (topic, index) { list.appendChild(buildRow(topic, country, index + 1)); });
      }
      list.setAttribute('aria-busy', 'false');
    }

    function showUnavailable() {
      list.replaceChildren();
      var message = document.createElement('p');
      message.className = 'gd-trending-loading';
      message.textContent = 'Trends are temporarily unavailable. Please check back shortly.';
      list.appendChild(message);
      summary.textContent = 'Trends could not be loaded';
      list.setAttribute('aria-busy', 'false');
    }

    function update() {
      fetch('/trending.json?refresh=' + Date.now(), { cache: 'no-store' })
        .then(function (response) { if (!response.ok) throw new Error('Trends unavailable'); return response.json(); })
        .then(render)
        .catch(showUnavailable);
    }
    update();
    window.setInterval(update, 60 * 60 * 1000);
    countryFilter.addEventListener('change', drawTopics);
    countryFilter.addEventListener('change', updateLocalTime);
    categoryFilter.addEventListener('change', drawTopics);
    statusFilter.addEventListener('change', drawTopics);
    sortFilter.addEventListener('change', drawTopics);
  })();
</script>
